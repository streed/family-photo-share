#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Remove a potentially pre-existing server.pid for Rails.
rm -f /rails/tmp/pids/server.pid

# Does this invocation boot the web server?
#
# This used to compare the literal last two arguments against
# "./bin/rails server". Anything else -- a start command carrying flags
# ("./bin/rails server -b 0.0.0.0 -p $PORT"), a different path to the binary
# ("bin/rails server", "bundle exec rails server"), or booting Puma directly --
# fell through the check, so db:prepare never ran. The container still started
# normally, against a database missing whatever the deploy had just added, and
# the first page touching a new column died with an undefined-method error far
# away from the real cause. Match the whole command line instead.
boots_web_server() {
  local previous=""
  local argument

  for argument in "$@"; do
    case "$previous" in
      rails|*/rails)
        if [ "$argument" = "server" ] || [ "$argument" = "s" ]; then
          return 0
        fi
        ;;
    esac

    case "$argument" in
      puma|*/puma) return 0 ;;
    esac

    previous="$argument"
  done

  return 1
}

if boots_web_server "${@}"; then
  echo "Starting Family Photo Share web server..."
  
  # Wait for the database SERVER to accept connections if DATABASE_URL is set.
  #
  # This deliberately does not run a query against the application database.
  # It used to wait on `select 1`, which fails with NoDatabaseError until the
  # database exists — but the only thing that creates it is the `db:prepare`
  # below. On a first deploy against an empty Postgres the container therefore
  # looped "Database is unavailable" forever and never started.
  if [ -n "$DATABASE_URL" ]; then
    echo "Waiting for database server to accept connections..."
    attempts=0
    until pg_isready -d "$DATABASE_URL" >/dev/null 2>&1; do
      attempts=$((attempts + 1))
      if [ "$attempts" -ge 150 ]; then
        echo "Database server did not become ready after 5 minutes; giving up." >&2
        exit 1
      fi
      echo "Database server is unavailable - sleeping"
      sleep 2
    done
    echo "Database server is ready!"
  fi
  
  echo "Preparing database..."
  ./bin/rails db:prepare

  # Refuse to serve traffic against a schema the code has outgrown.
  #
  # db:prepare exiting non-zero already stops the boot (set -e), but a schema
  # that is merely behind is silent: the app starts, and only the pages using a
  # column the deploy expected fail, with an error naming the view rather than
  # the migration. Check explicitly so a bad deploy is obvious at boot.
  if ! ./bin/rails db:abort_if_pending_migrations; then
    echo "Database has migrations that did not apply; refusing to start." >&2
    exit 1
  fi
  
  # Create default admin user if no users exist and ADMIN_EMAIL is set
  if [ -n "$ADMIN_EMAIL" ] && [ -n "$ADMIN_PASSWORD" ]; then
    ./bin/rails runner "
      if User.count == 0
        user = User.new(
          email: '$ADMIN_EMAIL',
          password: '$ADMIN_PASSWORD',
          password_confirmation: '$ADMIN_PASSWORD',
          first_name: 'Admin',
          last_name: 'User'
        )
        user.skip_confirmation! if user.respond_to?(:skip_confirmation!)
        if user.save
          puts 'Created admin user: $ADMIN_EMAIL'
        else
          puts 'Failed to create admin user: ' + user.errors.full_messages.join(', ')
        end
      end
    "
  fi
fi

exec "${@}"
