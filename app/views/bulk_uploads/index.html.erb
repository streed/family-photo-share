<% content_for :title, "Upload history — Family Memories" %>

<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title">Upload history</h1>
      <p class="page-subtitle">Every batch you've sent, and how it went.</p>
    </div>
    <%= link_to new_bulk_upload_path, class: "btn btn-primary" do %>
      <i class="fas fa-arrow-up-from-bracket" aria-hidden="true"></i> New batch
    <% end %>
  </div>

  <% if @bulk_uploads.any? %>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      <% @bulk_uploads.each do |bulk_upload| %>
        <% succeeded = bulk_upload.processed_count - bulk_upload.failed_count %>
        <% percent = bulk_upload.total_count.to_i.zero? ? 0 : (bulk_upload.processed_count.to_f / bulk_upload.total_count * 100).round %>
        <div class="card">
          <div class="card-head">
            <span class="meta"><%= bulk_upload.created_at.strftime("%b %-d, %Y at %-I:%M %p") %></span>
            <span class="badge <%= status_badge_class(bulk_upload.status) %>"><%= bulk_upload.status.titleize %></span>
          </div>

          <div class="card-body">
            <dl class="mb-4 grid grid-cols-3 gap-2 text-center">
              <div>
                <dd class="font-display text-2xl font-semibold text-ink"><%= bulk_upload.total_count %></dd>
                <dt class="meta">Sent</dt>
              </div>
              <div>
                <dd class="font-display text-2xl font-semibold text-sage"><%= succeeded %></dd>
                <dt class="meta">Added</dt>
              </div>
              <div>
                <dd class="font-display text-2xl font-semibold <%= bulk_upload.failed_count.to_i.positive? ? "text-danger" : "text-muted" %>"><%= bulk_upload.failed_count %></dd>
                <dt class="meta">Failed</dt>
              </div>
            </dl>

            <div class="progress-track mb-4">
              <div class="progress-fill <%= progress_bar_class(bulk_upload.status) %>"
                   style="width: <%= bulk_upload.processing? ? percent : 100 %>%"
                   role="progressbar"
                   aria-valuenow="<%= bulk_upload.processing? ? percent : 100 %>"
                   aria-valuemin="0"
                   aria-valuemax="100"></div>
            </div>

            <p class="meta mb-4">
              <% if bulk_upload.album.present? %>
                <i class="fas fa-book-open" aria-hidden="true"></i>
                Added to <%= link_to bulk_upload.album.name, album_path(bulk_upload.album), class: "link" %>
              <% else %>
                <i class="fas fa-images" aria-hidden="true"></i> Not added to an album
              <% end %>
            </p>

            <%= link_to "See details", bulk_upload_path(bulk_upload), class: "btn btn-secondary btn-sm btn-block" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <i class="fas fa-cloud-arrow-up empty-icon" aria-hidden="true"></i>
      <h2 class="section-title">No batches yet</h2>
      <p class="meta max-w-sm">The batch uploader takes a whole camera roll at once and sorts it into an album for you.</p>
      <%= link_to "Upload a batch", new_bulk_upload_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>
