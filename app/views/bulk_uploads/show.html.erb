<% content_for :title, "Batch upload — Family Memories" %>
<% percent = @bulk_upload.total_count.to_i.zero? ? 0 : (@bulk_upload.processed_count.to_f / @bulk_upload.total_count * 100).round %>

<% if @bulk_upload.processing? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<div class="shell">
  <div class="mx-auto max-w-4xl">
    <div class="card">
      <div class="card-head">
        <h1 class="section-title text-2xl">Batch upload</h1>
        <span class="badge <%= status_badge_class(@bulk_upload.status) %>"><%= @bulk_upload.status.titleize %></span>
      </div>

      <div class="card-body">
        <dl class="mb-5 grid grid-cols-2 gap-4 text-center sm:grid-cols-4">
          <div>
            <dd class="font-display text-3xl font-semibold text-ink"><%= @bulk_upload.total_count %></dd>
            <dt class="meta">Files sent</dt>
          </div>
          <div>
            <dd class="font-display text-3xl font-semibold text-sage"><%= @bulk_upload.processed_count - @bulk_upload.failed_count %></dd>
            <dt class="meta">Added</dt>
          </div>
          <div>
            <dd class="font-display text-3xl font-semibold <%= @bulk_upload.failed_count.to_i.positive? ? "text-danger" : "text-muted" %>"><%= @bulk_upload.failed_count %></dd>
            <dt class="meta">Failed</dt>
          </div>
          <div>
            <dd class="font-display text-3xl font-semibold text-teal"><%= @bulk_upload.success_rate %>%</dd>
            <dt class="meta">Success rate</dt>
          </div>
        </dl>

        <div class="progress-track mb-2">
          <div class="progress-fill <%= progress_bar_class(@bulk_upload.status) %>"
               style="width: <%= @bulk_upload.processing? ? percent : 100 %>%"
               role="progressbar"
               aria-valuenow="<%= @bulk_upload.processing? ? percent : 100 %>"
               aria-valuemin="0"
               aria-valuemax="100"></div>
        </div>

        <% if @bulk_upload.processing? %>
          <p class="meta mb-5 text-center">
            <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
            Working through your photos — <%= percent %>% done. This page refreshes itself.
          </p>
        <% else %>
          <p class="meta mb-5 text-center">Finished.</p>
        <% end %>

        <% if @bulk_upload.album.present? %>
          <div class="notice notice-info mb-4">
            <i class="fas fa-book-open mt-0.5 shrink-0" aria-hidden="true"></i>
            <div>
              These photos went into
              <%= link_to @bulk_upload.album.name, album_path(@bulk_upload.album), class: "link" %>.
            </div>
          </div>
        <% end %>

        <% if @bulk_upload.error_messages.present? %>
          <div class="notice notice-warning mb-4">
            <i class="fas fa-triangle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
            <div class="min-w-0">
              <p class="font-semibold">Some files didn't make it</p>
              <pre class="mt-1 overflow-x-auto whitespace-pre-wrap text-sm"><%= @bulk_upload.error_messages %></pre>
            </div>
          </div>
        <% end %>

        <div class="flex flex-wrap justify-center gap-2">
          <% if @bulk_upload.album.present? %>
            <%= link_to "Open the album", album_path(@bulk_upload.album), class: "btn btn-primary" %>
          <% end %>
          <%= link_to "All photos", photos_path, class: "btn btn-secondary" %>
          <%= link_to "Upload another batch", new_bulk_upload_path, class: "btn btn-secondary" %>
          <%= link_to "Upload history", bulk_uploads_path, class: "btn btn-ghost" %>
        </div>
      </div>
    </div>

    <% if @processed_photos.any? %>
      <section class="card mt-6">
        <div class="card-head">
          <h2 class="section-title">Added to your library (<%= @processed_photos.count %>)</h2>
        </div>
        <div class="card-body">
          <div class="grid-photos">
            <% @processed_photos.each do |photo| %>
              <%= link_to photo_path(photo), class: "tile" do %>
                <% if photo.image.attached? %>
                  <%= image_tag photo.short_thumbnail_url,
                        alt: photo_title_or_default(photo),
                        loading: "lazy",
                        class: "photo-thumbnail" %>
                <% end %>
                <div class="px-1 pb-1 pt-2">
                  <p class="truncate font-semibold text-ink"><%= truncated_photo_title(photo, length: 18) %></p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
