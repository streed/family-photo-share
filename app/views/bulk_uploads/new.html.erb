<% content_for :title, "Upload a batch — Family Memories" %>

<div class="shell" data-controller="bulk-upload">
  <div class="page-head">
    <div>
      <h1 class="page-title">Upload a batch</h1>
      <p class="page-subtitle">Pick a pile of photos, title the ones you care about, send them all at once.</p>
    </div>
    <%= link_to "Upload history", bulk_uploads_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%# --- Left: pick files ---------------------------------------------- %>
    <div class="space-y-6">
      <section class="card">
        <div class="card-head"><h2 class="section-title">Choose photos</h2></div>
        <div class="card-body">
          <div class="field">
            <label class="field-label" for="bulk-files">Photos</label>
            <input type="file"
                   id="bulk-files"
                   multiple
                   class="field-input py-2"
                   accept="image/*"
                   data-bulk-upload-target="multipleFileInput"
                   data-action="change->bulk-upload#addMultiplePhotos" />
            <p class="field-hint">JPEG, PNG or GIF, up to 50MB each, 100 at a time.</p>
          </div>

          <div class="field">
            <label class="field-label" for="bulk-album">Add them to an album</label>
            <select class="field-input" id="bulk-album" data-bulk-upload-target="albumSelect">
              <option value="">Don't add to an album</option>
              <% @own_albums.each do |album| %>
                <option value="<%= album.id %>"><%= album.name %></option>
              <% end %>
              <%# Family albums opened up for contributions — grouped separately so
                  it's obvious you're dropping photos into someone else's album. %>
              <% if @shared_albums.any? %>
                <optgroup label="Shared with your family">
                  <% @shared_albums.each do |album| %>
                    <option value="<%= album.id %>">
                      <%= album.name %> — <%= album.user.display_name_or_full_name %>
                    </option>
                  <% end %>
                </optgroup>
              <% end %>
            </select>
            <p class="field-hint">Optional — you can sort them later.</p>
          </div>

          <div class="notice notice-info mb-5" data-bulk-upload-target="stagingSummary" hidden>
            <i class="fas fa-images mt-0.5 shrink-0" aria-hidden="true"></i>
            <div>
              <strong><span data-bulk-upload-target="stagedCount">0</span></strong> photos ready,
              <strong><span data-bulk-upload-target="totalSize">0 MB</span></strong> in total.
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            <button type="button"
                    class="btn btn-primary btn-lg grow"
                    data-bulk-upload-target="uploadButton"
                    data-action="click->bulk-upload#startBulkUpload"
                    disabled>
              Upload <span data-bulk-upload-target="uploadCount">0</span> photos
            </button>
            <button type="button"
                    class="btn btn-danger-quiet btn-lg"
                    data-action="click->bulk-upload#clearAllStaged"
                    data-bulk-upload-target="bulkActionsBtn">
              Clear
            </button>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2 class="section-title">How it works</h2></div>
        <div class="card-body">
          <ol class="list-decimal space-y-1 pl-5">
            <li>Choose your photos — the whole selection at once is fine</li>
            <li>Give any of them a title or description</li>
            <li>Pick an album if you want them grouped</li>
            <li>Hit upload and leave the page open until it finishes</li>
          </ol>
        </div>
      </section>
    </div>

    <%# --- Right: staged photos ------------------------------------------ %>
    <section class="card">
      <div class="card-head">
        <h2 class="section-title">Ready to upload</h2>
        <span class="badge badge-link" data-bulk-upload-target="stagingBadge" hidden>
          <span data-bulk-upload-target="stagedCountBadge">0</span> selected
        </span>
      </div>

      <div class="card-body">
        <div data-bulk-upload-target="emptyState" class="empty border-0 bg-transparent">
          <i class="fas fa-images empty-icon" aria-hidden="true"></i>
          <h3 class="section-title">Nothing chosen yet</h3>
          <p class="meta">Pick some photos on the left and they'll line up here.</p>
        </div>

        <div data-bulk-upload-target="stagingContainer" hidden>
          <div data-bulk-upload-target="stagedPhotosGrid" class="max-h-[70vh] space-y-3 overflow-y-auto pr-1"></div>
        </div>
      </div>
    </section>
  </div>

  <%# --- Upload progress ------------------------------------------------- %>
  <div class="modal" data-bulk-upload-target="uploadModal" role="dialog" aria-modal="true" aria-labelledby="upload-progress-title">
    <div class="modal-overlay"></div>
    <div class="modal-panel">
      <div class="card-head">
        <h2 class="section-title" id="upload-progress-title">Uploading your photos</h2>
      </div>

      <div class="card-body">
        <div class="progress-track mb-3">
          <div class="progress-fill bg-primary" data-bulk-upload-target="progressBar" style="width: 0%"></div>
        </div>
        <p class="mb-1 text-center font-semibold text-ink"><span data-bulk-upload-target="progressText">0%</span></p>
        <p class="meta mb-1 text-center">
          Sending <span data-bulk-upload-target="currentFileName">…</span>
        </p>
        <p class="meta text-center">
          <span data-bulk-upload-target="uploadedCount">0</span> of
          <span data-bulk-upload-target="totalUploadCount">0</span> done
        </p>

        <div data-bulk-upload-target="uploadErrors" class="notice notice-danger mt-4" hidden>
          <i class="fas fa-circle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
          <div class="min-w-0">
            <p class="font-semibold">Some photos didn't upload</p>
            <ul class="mt-1 list-disc space-y-0.5 pl-5" data-bulk-upload-target="errorsList"></ul>
          </div>
        </div>
      </div>

      <div class="border-t border-edge-soft px-5 py-3">
        <p class="meta text-center">Keep this page open until it finishes.</p>
      </div>
    </div>
  </div>

  <%# --- Confirmation ---------------------------------------------------- %>
  <div class="modal" data-bulk-upload-target="confirmModal" role="dialog" aria-modal="true" aria-labelledby="bulk-confirm-title">
    <div class="modal-overlay" data-action="click->bulk-upload#cancelConfirm"></div>
    <div class="modal-panel">
      <div class="card-head">
        <h2 class="section-title" id="bulk-confirm-title" data-bulk-upload-target="confirmTitle">Are you sure?</h2>
      </div>
      <div class="card-body">
        <p data-bulk-upload-target="confirmMessage">Are you sure?</p>
      </div>
      <div class="flex flex-wrap justify-end gap-2 border-t border-edge-soft px-5 py-4">
        <button type="button" class="btn btn-ghost" data-action="click->bulk-upload#cancelConfirm">Cancel</button>
        <button type="button" class="btn btn-primary" data-action="click->bulk-upload#acceptConfirm" data-bulk-upload-target="confirmButton">
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>

<%# Hidden form that carries the files to the server. %>
<%= form_with model: @bulk_upload, multipart: true,
              class: "hidden",
              data: { "bulk-upload-target": "uploadForm" } do |form| %>
  <%= form.hidden_field :album_id, data: { "bulk-upload-target": "hiddenAlbumId" } %>
  <div data-bulk-upload-target="hiddenFilesContainer"></div>
<% end %>
