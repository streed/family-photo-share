<% content_for :title, "#{@user.display_name_or_full_name} — Family Memories" %>
<% is_self = @user == current_user %>

<div class="shell">
  <header class="card mb-8">
    <div class="card-body flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:p-8">
      <%= render "shared/avatar", user: @user, size: :lg %>

      <div class="min-w-0 grow">
        <h1 class="page-title"><%= @user.display_name_or_full_name %></h1>
        <% if @user.bio.present? %>
          <div class="mt-2 max-w-2xl text-body"><%= simple_format(@user.bio) %></div>
        <% end %>
        <p class="meta mt-2">
          Here since <%= @user.created_at.strftime("%B %Y") %>
          <% if @user.phone_number.present? && is_self %>
            · <%= @user.phone_number %>
          <% end %>
        </p>
      </div>

      <% if is_self %>
        <%= link_to "Settings", settings_path, class: "btn btn-secondary shrink-0" %>
      <% end %>
    </div>
  </header>

  <section>
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 class="section-title text-2xl">Albums</h2>
      <% if is_self && @albums.any? %>
        <%= link_to "All albums", albums_path, class: "link" %>
      <% end %>
    </div>

    <% if @albums.any? %>
      <div class="grid-albums">
        <%= render partial: "albums/album_card", collection: @albums, as: :album, locals: { owned: false } %>
      </div>

      <% if @user.albums.count > 12 %>
        <p class="meta mt-4 text-center">Showing 12 of <%= @user.albums.count %> albums.</p>
      <% end %>
    <% else %>
      <div class="empty">
        <i class="fas fa-book-open empty-icon" aria-hidden="true"></i>
        <h3 class="section-title">No albums yet</h3>
        <% if is_self %>
          <p class="meta">Create one to start grouping your photos.</p>
          <%= link_to "Create an album", new_album_path, class: "btn btn-primary" %>
        <% else %>
          <p class="meta"><%= @user.display_name_or_full_name %> hasn't shared any albums with the family yet.</p>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
