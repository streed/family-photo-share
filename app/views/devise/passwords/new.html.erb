<% content_for :title, "Reset your password — Family Memories" %>

<%= render layout: "shared/auth_card", locals: { title: "Reset your password", subtitle: "We'll email you a link to set a new one", icon: "fa-key" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email, "Email address", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "field-input", placeholder: "you@example.com" %>
      <p class="field-hint">Use the address you signed up with.</p>
    </div>

    <%= f.submit "Send reset link", class: "btn btn-primary btn-lg btn-block" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
