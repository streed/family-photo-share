<% content_for :title, "Choose a new password — Family Memories" %>

<%= render layout: "shared/auth_card", locals: { title: "Choose a new password", icon: "fa-key" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="field">
      <%= f.label :password, "New password", class: "field-label" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "field-input" %>
      <% if @minimum_password_length %>
        <p class="field-hint"><%= @minimum_password_length %> characters minimum.</p>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
    </div>

    <%= f.submit "Save new password", class: "btn btn-primary btn-lg btn-block" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
