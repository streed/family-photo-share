<% content_for :title, "Sign in — Family Memories" %>

<%= render layout: "shared/auth_card", locals: { title: "Welcome back", subtitle: "Sign in to see your family's photos", icon: "fa-images" } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field">
      <%= f.label :email, "Email address", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "field-input", placeholder: "you@example.com" %>
    </div>

    <div class="field">
      <%= f.label :password, "Password", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "current-password",
            class: "field-input", placeholder: "Your password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="check-row mb-5">
        <%= f.check_box :remember_me, class: "check-input" %>
        <%= f.label :remember_me, "Keep me signed in", class: "font-semibold text-ink" %>
      </div>
    <% end %>

    <%= f.submit "Sign in", class: "btn btn-primary btn-lg btn-block" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
