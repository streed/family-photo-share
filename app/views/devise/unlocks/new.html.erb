<% content_for :title, "Resend unlock instructions — Family Memories" %>

<%= render layout: "shared/auth_card", locals: { title: "Resend unlock instructions", subtitle: "Too many failed sign-ins locks an account for a while", icon: "fa-lock-open" } do %>
  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email, "Email address", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
    </div>

    <%= f.submit "Resend instructions", class: "btn btn-primary btn-lg btn-block" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
