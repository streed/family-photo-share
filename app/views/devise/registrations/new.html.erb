<% content_for :title, "Create an account — Family Memories" %>

<%= render layout: "shared/auth_card", locals: { title: "Create your account", subtitle: "It takes a minute, and then you can start uploading", icon: "fa-user-plus" } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="grid gap-x-4 sm:grid-cols-2">
      <div class="field">
        <%= f.label :first_name, "First name", class: "field-label" %>
        <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name",
              class: "field-input", placeholder: "Ada" %>
      </div>
      <div class="field">
        <%= f.label :last_name, "Last name", class: "field-label" %>
        <%= f.text_field :last_name, autocomplete: "family-name",
              class: "field-input", placeholder: "Lovelace" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :email, "Email address", class: "field-label" %>
      <%= f.email_field :email, autocomplete: "email", class: "field-input", placeholder: "you@example.com" %>
    </div>

    <div class="field">
      <%= f.label :phone_number, "Phone number", class: "field-label" %>
      <%= f.telephone_field :phone_number, autocomplete: "tel", class: "field-input", placeholder: "Optional" %>
    </div>

    <div class="field">
      <%= f.label :password, "Password", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "field-input", placeholder: "Choose a password" %>
      <% if @minimum_password_length %>
        <p class="field-hint"><%= @minimum_password_length %> characters minimum.</p>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input", placeholder: "Type it again" %>
    </div>

    <%= f.submit "Create account", class: "btn btn-primary btn-lg btn-block" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
