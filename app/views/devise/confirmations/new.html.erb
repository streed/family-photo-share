<% content_for :title, "Resend confirmation — Family Memories" %>

<%= render layout: "shared/auth_card", locals: { title: "Resend confirmation instructions", icon: "fa-envelope" } do %>
  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email, "Email address", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input",
            value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %>
    </div>

    <%= f.submit "Resend instructions", class: "btn btn-primary btn-lg btn-block" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
