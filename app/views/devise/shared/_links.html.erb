<%# Secondary routes out of an auth screen. One row of quiet links. %>
<nav class="mt-6 flex flex-col items-center gap-2 border-t border-edge-soft pt-5 text-sm">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Sign in", new_session_path(resource_name), class: "link" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' && signup_available? %>
    <% if session[:invitation_token].present? %>
      <%= link_to "Create an account", invitation_signup_path(session[:invitation_token]), class: "link" %>
    <% else %>
      <%= link_to "Create an account", new_user_registration_path, class: "link" %>
    <% end %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "link" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Resend confirmation instructions", new_confirmation_path(resource_name), class: "link" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Resend unlock instructions", new_unlock_path(resource_name), class: "link" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider),
            class: "btn btn-secondary btn-block", data: { turbo: false } %>
    <% end %>
  <% end %>
</nav>
