<%#
  Shared response for adding and removing a photo.

  Updates every part of the page that the change affects — the grid, the photo
  count in the toolbar, and the add-photo picker — so the album's displayed state
  and its real state never disagree. The old response replaced a single tile and
  left the count, the cover crown and the picker lying.

  Locals: added_photo / removed_photo (optional), notice
%>

<%# The grid, so ordering, the cover crown and the tile set are all correct. %>
<%= turbo_stream.replace "album_photo_grid" do %>
  <div class="grid-photos" id="album_photo_grid">
    <% @photos.each_with_index do |photo, index| %>
      <%= render "albums/photo_tile",
                 album: @album,
                 photo: photo,
                 index: index,
                 editable: @editable,
                 contributor: @contributor %>
    <% end %>
  </div>
<% end %>

<%# The count in the toolbar. %>
<%= turbo_stream.replace "album_photo_count" do %>
  <strong id="album_photo_count"><%= @album.photo_count %></strong>
<% end %>

<%# The picker: an added photo must leave it, a removed one must come back. %>
<%= turbo_stream.replace "album_add_photos" do %>
  <div id="album_add_photos">
    <%= render "albums/add_photos",
               album: @album,
               pickable_photos: @pickable_photos,
               addable_photo_count: @addable_photo_count,
               can_add: @can_add_photos %>
  </div>
<% end %>

<%= turbo_stream.prepend "album_flash" do %>
  <div class="notice notice-success mb-4 transition-opacity duration-300"
       role="status"
       data-controller="alert"
       data-alert-auto-dismiss-value="4000">
    <i class="fas fa-circle-check mt-0.5 shrink-0" aria-hidden="true"></i>
    <div class="grow"><%= notice %></div>
    <button type="button" class="-my-1 -mr-1 shrink-0 rounded-full px-2 py-1 opacity-70 hover:opacity-100"
            aria-label="Dismiss" data-action="click->alert#dismiss">
      <i class="fas fa-xmark" aria-hidden="true"></i>
    </button>
  </div>
<% end %>
