<%#
  Who can see this album, right now, in plain language.

  The owner's core question — "did sharing actually work?" — had no answer
  anywhere in the UI: a "Family" badge said what the setting was, never who that
  resolved to. This states the real audience, names the people, and links to the
  one control that changes it.
%>
<% viewers = album.family_viewers %>
<% shared_with_family = album.privacy == "family" %>

<div class="album-audience card mb-4">
  <div class="card-body">
    <div class="album-audience-head">
      <h5 class="card-title mb-0">
        <i class="fas fa-eye" aria-hidden="true"></i> Who can see this album
      </h5>
      <%= link_to "Change sharing", edit_album_path(album), class: "btn btn-sm btn-outline-primary" %>
    </div>

    <ul class="album-audience-list">
      <li class="album-audience-item">
        <span class="album-audience-icon"><i class="fas fa-user" aria-hidden="true"></i></span>
        <span><strong>You</strong> — <%= album.user.display_name_or_full_name %></span>
      </li>

      <li class="album-audience-item">
        <span class="album-audience-icon"><i class="fas fa-users" aria-hidden="true"></i></span>
        <% if !shared_with_family %>
          <span>
            <strong>Nobody in your family.</strong>
            This album is <strong>Private</strong>, so no one else can open it.
          </span>
        <% elsif album.user.family.blank? %>
          <span>
            <strong>Nobody yet.</strong>
            This album is set to <strong>Family</strong>, but you haven't joined a family —
            <%= link_to "create or join one", families_path %> and its members will see it.
          </span>
        <% elsif viewers.empty? %>
          <span>
            <strong>Nobody yet.</strong>
            You're the only member of <%= album.user.family.name %> —
            <%= link_to "invite someone", family_path(album.user.family) %> and they'll see this album.
          </span>
        <% else %>
          <span>
            <strong><%= pluralize(viewers.size, "family member") %></strong>
            in <%= album.user.family.name %>:
            <%= viewers.map { |m| m.display_name_or_full_name }.to_sentence %>
          </span>
        <% end %>
      </li>

      <li class="album-audience-item">
        <span class="album-audience-icon"><i class="fas fa-link" aria-hidden="true"></i></span>
        <% if !album.allow_external_access? %>
          <span><strong>No one with a link.</strong> External sharing is off.</span>
        <% elsif album.photo_count.zero? %>
          <span>
            <strong>Anyone with the link</strong> — but the album is empty, so there is nothing to see yet.
          </span>
        <% elsif album.external_password.present? %>
          <span><strong>Anyone with the link and the password</strong> (see below).</span>
        <% else %>
          <span><strong>Anyone with the link</strong> — no password required.</span>
        <% end %>
      </li>
    </ul>

    <% if shared_with_family && album.photo_count.zero? %>
      <p class="album-audience-note mb-0">
        This album is shared, but it has no photos in it yet — add some below and your family will see them.
      </p>
    <% end %>
  </div>
</div>

<style>
  .album-audience .card-body { padding: 20px 24px; }

  .album-audience-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .album-audience-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .album-audience-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    line-height: 1.45;
  }

  .album-audience-icon {
    flex: 0 0 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(107, 93, 79, 0.1);
    color: #6b5d4f;
    font-size: 0.8rem;
  }

  .album-audience-note {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(107, 93, 79, 0.15);
    font-size: 0.9rem;
    color: #6c757d;
  }
</style>
