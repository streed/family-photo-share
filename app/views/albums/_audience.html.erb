<%#
  Who can see this album, right now, in plain language.

  The owner's core question — "did sharing actually work?" — had no answer
  anywhere in the UI: a "Family" badge said what the setting was, never who that
  resolved to. This states the real audience, names the people, and links to the
  one control that changes it.
%>
<% viewers = album.family_viewers %>
<% shared_with_family = album.privacy == "family" %>

<section class="card mb-6">
  <div class="card-head">
    <h2 class="section-title">
      <i class="fas fa-eye mr-1 text-primary" aria-hidden="true"></i> Who can see this album
    </h2>
    <%= link_to "Change sharing", edit_album_path(album), class: "btn btn-secondary btn-sm" %>
  </div>

  <div class="card-body">
    <ul class="grid gap-3">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-paper-deep text-xs text-primary">
          <i class="fas fa-user" aria-hidden="true"></i>
        </span>
        <span><strong class="text-ink">You</strong> — <%= album.user.display_name_or_full_name %></span>
      </li>

      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-paper-deep text-xs text-primary">
          <i class="fas fa-users" aria-hidden="true"></i>
        </span>
        <% if !shared_with_family %>
          <span>
            <strong class="text-ink">Nobody in your family.</strong>
            This album is private, so no one else can open it.
          </span>
        <% elsif album.user.family.blank? %>
          <span>
            <strong class="text-ink">Nobody yet.</strong>
            This album is shared with your family, but you haven't joined one —
            <%= link_to "create or join a family", families_path, class: "link" %> and its members will see it.
          </span>
        <% elsif viewers.empty? %>
          <span>
            <strong class="text-ink">Nobody yet.</strong>
            You're the only member of <%= album.user.family.name %> —
            <%= link_to "invite someone", family_path(album.user.family), class: "link" %> and they'll see this album.
          </span>
        <% else %>
          <span>
            <strong class="text-ink"><%= pluralize(viewers.size, "family member") %></strong>
            in <%= album.user.family.name %>:
            <%= viewers.map { |m| m.display_name_or_full_name }.to_sentence %>
          </span>
        <% end %>
      </li>

      <% if shared_with_family %>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-paper-deep text-xs text-primary">
            <i class="fas fa-user-plus" aria-hidden="true"></i>
          </span>
          <% if album.allow_contributions? %>
            <% contributed_by = album.contributing_users.to_a %>
            <span>
              <strong class="text-ink">They can add photos, too.</strong>
              Anyone in <%= album.user.family&.name || "your family" %> can put their own photos
              in this album and take their own back out.
              <% if contributed_by.any? %>
                So far <%= contributed_by.map(&:display_name_or_full_name).to_sentence %>
                <%= contributed_by.one? ? "has" : "have" %> added to it.
              <% end %>
            </span>
          <% else %>
            <span>
              <strong class="text-ink">Only you can add photos.</strong>
              <%= link_to "Let your family add theirs", edit_album_path(album), class: "link" %>
              if it's an album you all shot together.
            </span>
          <% end %>
        </li>
      <% end %>

      <li class="flex items-start gap-3">
        <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-paper-deep text-xs text-primary">
          <i class="fas fa-link" aria-hidden="true"></i>
        </span>
        <% if !album.allow_external_access? %>
          <span><strong class="text-ink">No one with a link.</strong> Link sharing is off.</span>
        <% elsif album.photo_count.zero? %>
          <span>
            <strong class="text-ink">Anyone with the link</strong> — but the album is empty, so there's nothing to see yet.
          </span>
        <% elsif album.external_password.present? %>
          <span><strong class="text-ink">Anyone with the link and the password</strong> (below).</span>
        <% else %>
          <span><strong class="text-ink">Anyone with the link</strong> — no password required.</span>
        <% end %>
      </li>
    </ul>

    <% if shared_with_family && album.photo_count.zero? %>
      <p class="meta mt-4 border-t border-edge-soft pt-3">
        This album is shared, but there are no photos in it yet — add some below and your family will see them.
      </p>
    <% end %>
  </div>
</section>
