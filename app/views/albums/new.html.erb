<% content_for :title, "New album — Family Memories" %>

<div class="shell">
  <div class="mx-auto max-w-2xl">
    <h1 class="page-title mb-6">Create an album</h1>

    <div class="card">
      <div class="card-body">
        <%= form_with model: @album do |form| %>
          <%= render "shared/form_errors", record: @album %>

          <div class="field">
            <%= form.label :name, "Album name", class: "field-label" %>
            <%= form.text_field :name, class: "field-input", placeholder: "Summer at the lake" %>
          </div>

          <div class="field">
            <%= form.label :description, class: "field-label" %>
            <%= form.text_area :description, class: "field-input", rows: 3, placeholder: "Optional — a line about what's in it" %>
          </div>

          <div class="field">
            <%= form.label :privacy, "Who can see it", class: "field-label" %>
            <%= form.select :privacy,
                  options_for_select([
                    [ "Private — only you", "private" ],
                    [ "Family — everyone in your family", "family" ]
                  ], @album.privacy),
                  {},
                  { class: "field-input" } %>
            <p class="field-hint">You can change this later, and share a link separately.</p>
          </div>

          <div class="notice notice-info mb-6">
            <i class="fas fa-circle-info mt-0.5 shrink-0" aria-hidden="true"></i>
            <div>
              <p class="font-semibold">What happens next</p>
              <ul class="mt-1 list-disc space-y-0.5 pl-5">
                <li>Pick photos from your library to add them</li>
                <li>Photos stay in the order you add them — or sort by date taken</li>
                <li>Set any photo as the cover</li>
                <li>Share the whole album with a link when it's ready</li>
              </ul>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            <%= form.submit "Create album", class: "btn btn-primary" %>
            <%= link_to "Cancel", albums_path, class: "btn btn-ghost" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
