<% content_for :title, "#{@album.name} — Family Memories" %>
<%# @editable / @contributor / @can_add_photos are resolved in the controller:
    working them out per tile would ask the database for the owner's family once
    per photo in the grid. %>
<% editable = @editable %>
<% shareable = @album.allow_external_access? && @album.sharing_url.present? && editable %>

<div class="shell">
  <%# --- Album header ---------------------------------------------------- %>
  <header class="mb-6">
    <% if @album.cover_photo&.image&.attached? %>
      <div class="mounted overflow-hidden rounded-[var(--radius-card)] bg-primary-deep">
        <%= image_tag @album.cover_photo.short_large_url,
              alt: "",
              class: "h-56 w-full object-cover sm:h-72 lg:h-80" %>
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/10"></div>

        <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
          <h1 class="font-display text-3xl font-semibold text-white drop-shadow-sm sm:text-4xl"><%= @album.name %></h1>
          <% if @album.description.present? %>
            <p class="mt-1 max-w-2xl text-white/90"><%= @album.description %></p>
          <% end %>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <%= album_privacy_badge(@album, detailed: true) %>
            <%= album_contributions_badge(@album) %>
            <%= album_link_sharing_badge(@album) %>
            <span class="text-sm text-white/85">
              <%= pluralize(@album.photo_count, "photo") %> ·
              created <%= time_ago_in_words(@album.created_at) %> ago
            </span>
          </div>
        </div>

        <% if editable %>
          <div class="absolute right-4 top-4 flex gap-2">
            <%= link_to "Edit", edit_album_path(@album), class: "btn btn-sm btn-on-photo" %>
            <%= button_to "Delete", album_path(@album), method: :delete,
                  class: "btn btn-sm btn-on-photo",
                  form_class: "contents",
                  data: { turbo_confirm: "Delete “#{@album.name}”? The photos in it stay in your library." } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="page-head">
        <div>
          <h1 class="page-title"><%= @album.name %></h1>
          <% if @album.description.present? %>
            <p class="page-subtitle max-w-2xl"><%= @album.description %></p>
          <% end %>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <%= album_privacy_badge(@album, detailed: true) %>
            <%= album_contributions_badge(@album) %>
            <%= album_link_sharing_badge(@album) %>
            <span class="meta">
              <%= pluralize(@album.photo_count, "photo") %> ·
              created <%= time_ago_in_words(@album.created_at) %> ago
            </span>
          </div>
        </div>

        <% if editable %>
          <div class="flex gap-2">
            <%= link_to "Edit album", edit_album_path(@album), class: "btn btn-secondary btn-sm" %>
            <%= button_to "Delete", album_path(@album), method: :delete,
                  class: "btn btn-danger-quiet btn-sm",
                  form_class: "contents",
                  data: { turbo_confirm: "Delete “#{@album.name}”? The photos in it stay in your library." } %>
          </div>
        <% end %>
      </div>
    <% end %>
  </header>

  <% if editable %>
    <%= render "albums/audience", album: @album %>
  <% end %>

  <% if @contributor %>
    <section class="notice notice-info mb-6">
      <i class="fas fa-users mt-0.5 shrink-0" aria-hidden="true"></i>
      <div>
        <strong><%= @album.user.display_name_or_full_name %> opened this album up to the family.</strong>
        Add your own photos to it below — they stay in your library, and you can take
        them back out whenever you like.
      </div>
    </section>
  <% end %>

  <%# --- External sharing -------------------------------------------------- %>
  <% if shareable %>
    <section class="card mb-6">
      <div class="card-head">
        <h2 class="section-title">
          <i class="fas fa-share-nodes mr-1 text-primary" aria-hidden="true"></i> Share by link
        </h2>
        <div class="flex flex-wrap gap-2">
          <%= link_to view_events_album_path(@album), class: "btn btn-secondary btn-sm" do %>
            <i class="fas fa-chart-line" aria-hidden="true"></i> Guest activity
          <% end %>
          <%= link_to guest_sessions_album_path(@album), class: "btn btn-secondary btn-sm" do %>
            <i class="fas fa-users" aria-hidden="true"></i> Guest sessions
          <% end %>
        </div>
      </div>

      <div class="card-body">
        <div class="grid gap-5 <%= "sm:grid-cols-[minmax(0,1fr)_auto]" if @album.photo_count > 0 %>">
          <div class="min-w-0">
            <p class="meta mb-2">Anyone with this link can open the album — no account needed.</p>

            <div class="flex flex-col gap-2 sm:flex-row" data-controller="clipboard">
              <input type="text"
                     class="field-input token grow"
                     data-clipboard-target="source"
                     aria-label="Album sharing link"
                     value="<%= @album.sharing_url %>"
                     readonly>
              <button class="btn btn-secondary shrink-0" type="button"
                      data-clipboard-target="button"
                      data-action="clipboard#copy">
                <i class="fas fa-copy" aria-hidden="true"></i> Copy link
              </button>
            </div>

            <% if @album.external_password.blank? %>
              <div class="notice notice-warning mt-4">
                <i class="fas fa-triangle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
                <div>
                  <strong>No password set.</strong>
                  Anyone with the link can open this album.
                  <%= link_to "Add a password", edit_album_path(@album), class: "link" %> to restrict it.
                </div>
              </div>
            <% elsif @album.external_password_hashed? %>
              <%# Never print the stored value here — it's a bcrypt digest, and an
                  owner who copies it and sends it locks their guests out. %>
              <div class="notice notice-info mt-4">
                <i class="fas fa-lock mt-0.5 shrink-0" aria-hidden="true"></i>
                <div>
                  <strong>Password protected.</strong>
                  The password is stored encrypted and can't be shown.
                  <%= link_to "Set a new one", edit_album_path(@album), class: "link" %> if you've forgotten it.
                </div>
              </div>
            <% else %>
              <div class="notice notice-info mt-4" data-controller="clipboard">
                <i class="fas fa-lock mt-0.5 shrink-0" aria-hidden="true"></i>
                <div class="min-w-0">
                  <strong>Password protected.</strong> Send this password along with the link.
                  <div class="mt-2 flex flex-wrap items-center gap-2">
                    <code class="token rounded bg-white/70 px-2 py-1" data-clipboard-target="source"><%= @album.external_password %></code>
                    <button class="btn btn-sm btn-secondary" type="button"
                            data-clipboard-target="button"
                            data-action="clipboard#copy"
                            aria-label="Copy album password">
                      <i class="fas fa-copy" aria-hidden="true"></i> Copy
                    </button>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <% if @album.photo_count > 0 %>
            <figure class="justify-self-center text-center">
              <%= image_tag qr_code_data_url(@album.sharing_url),
                    alt: "QR code for #{@album.name}",
                    class: "qr-code-image h-28 w-28 rounded-lg border border-edge bg-white p-1.5" %>
              <figcaption class="meta mt-1">Scan to share</figcaption>
            </figure>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <%# Anchor for turbo_stream flashes from add/remove. %>
  <div id="album_flash"></div>

  <%# --- Photos ------------------------------------------------------------ %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <p class="meta">
      <strong id="album_photo_count" class="text-ink"><%= @album.photo_count %></strong>
      <%= "photo".pluralize(@album.photo_count) %> in this album
    </p>

    <% if @photos.size > 1 %>
      <div class="flex items-center gap-2">
        <span class="meta">Order</span>
        <div class="segmented">
          <%= link_to "Album order", album_path(@album, sort: "position"),
                class: "seg-btn #{'seg-btn-active' if @sort == 'position'}",
                "aria-current": (@sort == "position" ? "true" : nil) %>
          <%= link_to "Date taken", album_path(@album, sort: "date_taken"),
                class: "seg-btn #{'seg-btn-active' if @sort == 'date_taken'}",
                "aria-current": (@sort == "date_taken" ? "true" : nil) %>
        </div>
      </div>
    <% end %>
  </div>

  <div data-controller="slideshow">
    <%# The grid container renders unconditionally so turbo_stream always has a
        stable target, even when the album is empty. %>
    <div class="grid-photos" id="album_photo_grid">
      <% @photos.each_with_index do |photo, index| %>
        <%= render "albums/photo_tile",
                   album: @album,
                   photo: photo,
                   index: index,
                   editable: editable,
                   contributor: @contributor %>
      <% end %>
    </div>

    <% if @photos.empty? %>
      <div class="empty">
        <i class="fas fa-images empty-icon" aria-hidden="true"></i>
        <h2 class="section-title">No photos in this album yet</h2>
        <p class="meta"><%= @can_add_photos ? "Pick one from your library below." : "This album is empty." %></p>
      </div>
    <% end %>

    <%# --- Slideshow ------------------------------------------------------- %>
    <div class="modal" data-slideshow-target="modal"
         role="dialog" aria-modal="true" aria-hidden="true" aria-label="Photo viewer">
      <div class="modal-overlay" data-action="click->slideshow#close" aria-hidden="true"></div>

      <div class="relative z-10 flex h-full w-full flex-col items-center justify-center p-4">
        <button class="icon-btn absolute right-4 top-4 z-20" type="button"
                aria-label="Close photo viewer" data-action="click->slideshow#close">
          <i class="fas fa-xmark" aria-hidden="true"></i>
        </button>

        <button class="icon-btn absolute left-2 top-1/2 z-20 h-12 w-12 -translate-y-1/2 sm:left-6" type="button"
                aria-label="Previous photo" data-action="click->slideshow#previous">
          <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>

        <img class="max-h-[75vh] max-w-full rounded-lg object-contain shadow-[var(--shadow-lift)]"
             data-slideshow-target="image" src="" alt="">

        <div class="mt-4 max-w-xl text-center text-white">
          <h3 class="font-display text-xl font-semibold text-white" data-slideshow-target="title"></h3>
          <p class="mt-1 text-white/85" data-slideshow-target="description"></p>
          <p class="mt-1 text-sm text-white/70">
            Photo <span data-slideshow-target="counter"></span> of <%= @photos.size %>
            · by <span data-slideshow-target="user"></span>
          </p>
        </div>

        <button class="icon-btn absolute right-2 top-1/2 z-20 h-12 w-12 -translate-y-1/2 sm:right-6" type="button"
                aria-label="Next photo" data-action="click->slideshow#next">
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>

  <div id="album_add_photos">
    <%= render "albums/add_photos",
               album: @album,
               pickable_photos: @pickable_photos,
               addable_photo_count: @addable_photo_count,
               can_add: @can_add_photos %>
  </div>
</div>
