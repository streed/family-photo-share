<% content_for :title, "Guest sessions — #{@album.name}" %>

<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title">Guest sessions</h1>
      <p class="page-subtitle">Who currently has “<%= @album.name %>” open.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to view_events_album_path(@album), class: "btn btn-secondary btn-sm" do %>
        <i class="fas fa-chart-line" aria-hidden="true"></i> Guest activity
      <% end %>
      <%= link_to @album, class: "btn btn-ghost btn-sm" do %>
        <i class="fas fa-chevron-left" aria-hidden="true"></i> Back to album
      <% end %>
    </div>
  </div>

  <div class="mb-8 grid grid-cols-3 gap-3 sm:gap-4">
    <div class="card p-4">
      <span class="block font-display text-3xl font-semibold text-sage"><%= @active_sessions.count %></span>
      <span class="meta">open now</span>
    </div>
    <div class="card p-4">
      <span class="block font-display text-3xl font-semibold text-ink"><%= @expired_sessions.count %></span>
      <span class="meta">recently ended</span>
    </div>
    <div class="card p-4">
      <span class="block font-display text-3xl font-semibold text-ink"><%= @total_sessions_count %></span>
      <span class="meta">since you shared it</span>
    </div>
  </div>

  <section class="card mb-6">
    <div class="card-head">
      <div>
        <h2 class="section-title">Open now</h2>
        <p class="meta">A session ends after 10 minutes without activity.</p>
      </div>
      <% if @active_sessions.any? %>
        <%= button_to revoke_all_guest_sessions_album_path(@album), method: :patch,
              class: "btn btn-danger-quiet btn-sm",
              form_class: "contents",
              data: { turbo_confirm: "End every open guest session? Anyone viewing right now will have to enter the password again." } do %>
          End all sessions
        <% end %>
      <% end %>
    </div>

    <% if @active_sessions.any? %>
      <div class="rows">
        <% @active_sessions.each do |session| %>
          <div class="row-item">
            <div class="min-w-0">
              <p class="font-semibold text-ink"><%= ip_location_label(session.ip_address, @ip_locations) %></p>
              <p class="meta token"><%= session.ip_address %></p>
              <p class="meta">
                Started <%= time_ago_in_words(session.created_at) %> ago ·
                last seen <%= time_ago_in_words(session.accessed_at) %> ago ·
                ends in <%= pluralize(session.expires_in_minutes.ceil, "minute") %>
              </p>
            </div>

            <div class="flex items-center gap-2">
              <span class="badge badge-family">Open</span>
              <%= button_to revoke_guest_session_album_path(@album, session_token: session.session_token),
                    method: :delete,
                    class: "btn btn-danger-quiet btn-sm",
                    form_class: "contents",
                    data: { turbo_confirm: "End this session? They'll have to enter the password again." } do %>
                End
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card-body">
        <div class="empty border-0 bg-transparent">
          <i class="fas fa-users empty-icon" aria-hidden="true"></i>
          <h3 class="section-title">Nobody's viewing right now</h3>
          <p class="meta">Guests appear here while they have the album open.</p>
        </div>
      </div>
    <% end %>
  </section>

  <% if @expired_sessions.any? %>
    <section class="card">
      <div class="card-head">
        <div>
          <h2 class="section-title">Recently ended</h2>
          <p class="meta">The last 20 sessions that have closed.</p>
        </div>
      </div>

      <div class="rows">
        <% @expired_sessions.each do |session| %>
          <div class="row-item">
            <div class="min-w-0">
              <p class="font-semibold text-ink"><%= ip_location_label(session.ip_address, @ip_locations) %></p>
              <p class="meta token"><%= session.ip_address %></p>
              <p class="meta">
                Started <%= time_ago_in_words(session.created_at) %> ago ·
                lasted <%= distance_of_time_in_words(session.created_at, session.accessed_at) %>
              </p>
            </div>
            <span class="badge badge-private">Ended</span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
