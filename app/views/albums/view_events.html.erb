<% content_for :title, "Guest activity — #{@album.name}" %>

<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title">Guest activity</h1>
      <p class="page-subtitle">Who's been looking at “<%= @album.name %>” over the past 7 days.</p>
    </div>
    <%= link_to @album, class: "btn btn-ghost btn-sm" do %>
      <i class="fas fa-chevron-left" aria-hidden="true"></i> Back to album
    <% end %>
  </div>

  <div class="mb-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    <div class="card p-4">
      <span class="block font-display text-3xl font-semibold text-ink"><%= @unique_visitors %></span>
      <span class="meta">unique visitors</span>
    </div>
    <div class="card p-4">
      <span class="block font-display text-3xl font-semibold text-ink"><%= @total_photo_views %></span>
      <span class="meta">photo views</span>
    </div>
    <div class="card p-4">
      <span class="block font-display text-3xl font-semibold text-ink"><%= @password_attempts %></span>
      <span class="meta">password entries</span>
    </div>
    <div class="card p-4">
      <% failed = @event_counts["password_attempt_failed"] || 0 %>
      <span class="block font-display text-3xl font-semibold <%= failed.positive? ? "text-danger" : "text-ink" %>"><%= failed %></span>
      <span class="meta">failed attempts</span>
    </div>
  </div>

  <section class="card">
    <div class="card-head">
      <h2 class="section-title">Recent activity</h2>
      <span class="meta">Locations are approximate, from the visitor's IP address</span>
    </div>

    <% if @events.any? %>
      <%# A table on wide screens, stacked rows on a phone. %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[46rem] text-left text-sm max-sm:hidden">
          <thead>
            <tr class="border-b border-edge-soft bg-paper-deep">
              <th class="px-4 py-3 font-semibold text-ink">What happened</th>
              <th class="px-4 py-3 font-semibold text-ink">When</th>
              <th class="px-4 py-3 font-semibold text-ink">Where (approx.)</th>
              <th class="px-4 py-3 font-semibold text-ink">Photo</th>
            </tr>
          </thead>
          <tbody>
            <% @events.each do |event| %>
              <tr class="border-b border-edge-soft last:border-0">
                <td class="px-4 py-3"><%= event_type_badge(event.event_type) %></td>
                <td class="px-4 py-3">
                  <div class="text-ink"><%= time_ago_in_words(event.occurred_at) %> ago</div>
                  <div class="meta"><%= event.occurred_at.strftime("%b %-d at %-I:%M %p") %></div>
                </td>
                <td class="px-4 py-3">
                  <div class="text-ink"><%= ip_location_label(event.ip_address, @ip_locations) %></div>
                  <div class="meta token"><%= event.ip_address %></div>
                </td>
                <td class="px-4 py-3">
                  <% if event.photo.present? %>
                    <div class="flex items-center gap-2">
                      <%= image_tag event.photo.short_thumbnail_url, alt: "", class: "h-9 w-9 rounded object-cover" %>
                      <span class="truncate"><%= truncated_photo_title(event.photo, length: 22) %></span>
                    </div>
                  <% else %>
                    <span class="meta">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="rows sm:hidden">
        <% @events.each do |event| %>
          <div class="row-item flex-col items-start gap-1">
            <div class="flex w-full items-center justify-between gap-2">
              <%= event_type_badge(event.event_type) %>
              <span class="meta"><%= time_ago_in_words(event.occurred_at) %> ago</span>
            </div>
            <div class="text-ink"><%= ip_location_label(event.ip_address, @ip_locations) %></div>
            <div class="meta token"><%= event.ip_address %></div>
            <% if event.photo.present? %>
              <div class="mt-1 flex items-center gap-2">
                <%= image_tag event.photo.short_thumbnail_url, alt: "", class: "h-8 w-8 rounded object-cover" %>
                <span class="meta truncate"><%= truncated_photo_title(event.photo, length: 24) %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card-body">
        <div class="empty border-0 bg-transparent">
          <i class="fas fa-chart-line empty-icon" aria-hidden="true"></i>
          <h3 class="section-title">Nothing yet</h3>
          <p class="meta">No guest has opened this album in the past 7 days.</p>

          <% if @album.allow_external_access? %>
            <div class="notice notice-info mt-2 max-w-xl text-left" data-controller="clipboard">
              <i class="fas fa-share-nodes mt-0.5 shrink-0" aria-hidden="true"></i>
              <div class="min-w-0">
                <p class="font-semibold">Share the album to start seeing activity</p>
                <div class="mt-2 flex flex-wrap items-center gap-2">
                  <code class="token min-w-0 rounded bg-white/70 px-2 py-1" data-clipboard-target="source"><%= external_album_url(@album.sharing_token) %></code>
                  <button class="btn btn-sm btn-secondary" type="button"
                          data-clipboard-target="button" data-action="clipboard#copy">
                    <i class="fas fa-copy" aria-hidden="true"></i> Copy
                  </button>
                </div>
              </div>
            </div>
          <% else %>
            <div class="notice notice-warning mt-2 max-w-xl text-left">
              <i class="fas fa-circle-info mt-0.5 shrink-0" aria-hidden="true"></i>
              <div>
                Link sharing is off for this album.
                <%= link_to "Turn it on", edit_album_path(@album), class: "link" %> to start tracking guest visits.
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>
