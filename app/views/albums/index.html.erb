<% content_for :title, "My albums — Family Memories" %>

<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title">My Albums</h1>
      <p class="page-subtitle">Group photos together, then share the whole album at once.</p>
    </div>
    <%= link_to new_album_path, class: "btn btn-primary" do %>
      <i class="fas fa-plus" aria-hidden="true"></i> New album
    <% end %>
  </div>

  <nav class="segmented mb-6" aria-label="Filter albums by privacy">
    <% [ [ "All", nil ], [ "Private", "private" ], [ "Family", "family" ] ].each do |label, value| %>
      <% active = params[:privacy].presence == value %>
      <%= link_to label,
            (value ? albums_path(privacy: value) : albums_path),
            class: "seg-btn #{'seg-btn-active' if active}",
            "aria-current": (active ? "true" : nil) %>
    <% end %>
  </nav>

  <% if @albums.any? %>
    <div class="grid-albums">
      <%= render partial: "albums/album_card", collection: @albums, as: :album, locals: { owned: true } %>
    </div>
  <% else %>
    <div class="empty">
      <i class="fas fa-book-open empty-icon" aria-hidden="true"></i>
      <h2 class="section-title">
        <%= params[:privacy].present? ? "No #{params[:privacy]} albums" : "No albums yet" %>
      </h2>
      <p class="meta max-w-sm">
        An album keeps a set of photos in the order you choose — and gives you one link to share them all.
      </p>
      <%= link_to "Create an album", new_album_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>

  <%# Albums other family members have shared. Without this the recipient side of
      "Family" sharing has no surface anywhere in the app. %>
  <% if @family_albums.any? %>
    <section class="mt-12 border-t border-edge-soft pt-8">
      <h2 class="section-title text-2xl">Shared with you</h2>
      <p class="meta mb-5">Albums your family has shared with everyone.</p>

      <div class="grid-albums">
        <%= render partial: "albums/album_card", collection: @family_albums, as: :album, locals: { owned: false } %>
      </div>
    </section>
  <% end %>
</div>
