<% content_for :title, "Edit #{@album.name} — Family Memories" %>

<div class="shell">
  <div class="mx-auto max-w-2xl">
    <h1 class="page-title mb-6">Edit album</h1>

    <div class="card">
      <div class="card-body">
        <%= form_with model: @album do |form| %>
          <%= render "shared/form_errors", record: @album %>

          <div class="field">
            <%= form.label :name, "Album name", class: "field-label" %>
            <%= form.text_field :name, class: "field-input", placeholder: "Summer at the lake" %>
          </div>

          <div class="field">
            <%= form.label :description, class: "field-label" %>
            <%= form.text_area :description, class: "field-input", rows: 3, placeholder: "Optional — a line about what's in it" %>
          </div>

          <div class="field">
            <%= form.label :privacy, "Who can see it", class: "field-label" %>
            <%= form.select :privacy,
                  options_for_select([
                    [ "Private — only you", "private" ],
                    [ "Family — everyone in your family", "family" ]
                  ], @album.privacy),
                  {},
                  { class: "field-input" } %>
          </div>

          <%# --- Link sharing -------------------------------------------- %>
          <section class="my-6 rounded-[var(--radius-card)] border border-edge-soft bg-paper-deep p-5"
                   data-controller="toggle">
            <h2 class="section-title mb-3">
              <i class="fas fa-share-nodes mr-1 text-primary" aria-hidden="true"></i> Share by link
            </h2>

            <div class="check-row">
              <%= form.check_box :allow_external_access,
                    class: "check-input",
                    data: { toggle_target: "checkbox", action: "change->toggle#sync" } %>
              <div>
                <%= form.label :allow_external_access, "Anyone with the link can view this album", class: "font-semibold text-ink" %>
                <p class="field-hint">Useful for grandparents and friends who don't have an account here.</p>
              </div>
            </div>

            <div class="mt-4 rounded-[12px] border border-edge-soft bg-card p-4" data-toggle-target="panel" hidden>
              <div class="field">
                <%= form.label :password, "Password", class: "field-label" %>
                <%# A visible text field, prefilled: this is a password the owner has
                    to pass on to guests, so it is no use to them hidden. A legacy
                    bcrypt digest is never prefilled — saving it back would set the
                    password *to* the digest and lock every guest out. %>
                <%= form.text_field :password,
                      value: (@album.external_password unless @album.external_password_hashed?),
                      class: "field-input",
                      placeholder: "At least #{Album::EXTERNAL_PASSWORD_MIN_LENGTH} characters",
                      autocomplete: "off",
                      autocapitalize: "none",
                      autocorrect: "off",
                      spellcheck: "false" %>
                <p class="field-hint">
                  Anyone you send the link to needs this to open the album.
                  <% if @album.external_password_hashed? %>
                    The current one was stored encrypted and can't be shown — type a new one to replace it.
                  <% else %>
                    Leave it as it is to keep the current password.
                  <% end %>
                </p>
              </div>

              <% if @album.allow_external_access? && @album.sharing_token.present? %>
                <div class="mt-4 border-t border-edge-soft pt-4">
                  <p class="field-label">Share link</p>
                  <div class="flex flex-col gap-2 sm:flex-row" data-controller="clipboard">
                    <input type="text"
                           class="field-input token grow"
                           data-clipboard-target="source"
                           aria-label="Album sharing link"
                           value="<%= @album.sharing_url %>"
                           readonly>
                    <button class="btn btn-secondary shrink-0" type="button"
                            data-clipboard-target="button"
                            data-action="clipboard#copy">
                      <i class="fas fa-copy" aria-hidden="true"></i> Copy
                    </button>
                  </div>

                  <div class="mt-4 flex flex-wrap items-center gap-4">
                    <figure class="text-center">
                      <%= image_tag qr_code_data_url(@album.sharing_url),
                            alt: "QR code for #{@album.name}",
                            class: "qr-code-image h-32 w-32 rounded-lg border border-edge bg-white p-2" %>
                      <figcaption class="meta mt-1">Scan to share</figcaption>
                    </figure>

                    <p class="meta">
                      <%= pluralize(@album.album_access_sessions.active.count, "active guest session") %>.
                      <% if @album.album_access_sessions.any? %>
                        Last opened <%= time_ago_in_words(@album.album_access_sessions.recent.first.accessed_at) %> ago.
                      <% else %>
                        Nobody has opened it yet.
                      <% end %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          </section>

          <% if @album.cover_photo %>
            <div class="field">
              <p class="field-label">Cover photo</p>
              <div class="flex items-center gap-3">
                <%= image_tag @album.cover_photo.short_thumbnail_url,
                      alt: photo_title_or_default(@album.cover_photo),
                      class: "h-20 w-20 rounded-lg object-cover" %>
                <div>
                  <p class="font-semibold text-ink"><%= photo_title_or_default(@album.cover_photo) %></p>
                  <p class="meta">Change it from the album page — tap the star on any photo.</p>
                </div>
              </div>
            </div>
          <% end %>

          <div class="flex flex-wrap gap-2">
            <%= form.submit "Save changes", class: "btn btn-primary" %>
            <%= link_to "View album", @album, class: "btn btn-secondary" %>
            <%= link_to "Cancel", albums_path, class: "btn btn-ghost" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
