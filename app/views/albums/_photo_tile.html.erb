<%#
  One photo tile in an album grid.

  Extracted so the initial page render and the turbo_stream responses for
  add/remove produce identical markup — previously the stream hand-wrote a
  different fragment and the two drifted apart.

  Locals: album, photo, index, editable
%>
<div class="group relative" id="<%= dom_id(photo) %>">
  <div class="tile cursor-zoom-in"
       role="button"
       tabindex="0"
       aria-label="View <%= photo_title_or_default(photo) %>"
       data-action="click->slideshow#open keydown.enter->slideshow#open keydown.space->slideshow#open"
       data-slideshow-index-value="<%= index %>"
       data-slideshow-photo-id-value="<%= photo.id %>">
    <div class="relative">
      <%= photo_thumbnail_tag photo,
                    data: {
                      large: photo.short_large_url,
                      title: photo_title_or_default(photo),
                      description: photo.description,
                      user: photo.user.display_name_or_full_name
                    } %>
      <%= photo_processing_badge(photo) %>
    </div>

    <div class="px-1 pb-1 pt-2">
      <p class="truncate font-semibold text-ink"><%= truncated_photo_title(photo, length: 30) %></p>
      <p class="meta truncate">by <%= photo.user.display_name_or_full_name %></p>
    </div>
  </div>

  <% if editable %>
    <div class="absolute right-2 top-2 flex gap-1 opacity-0 transition-opacity focus-within:opacity-100 group-hover:opacity-100 max-md:opacity-100">
      <% if album.cover_photo_id == photo.id %>
        <span class="icon-btn h-9 w-9 cursor-default bg-clay-soft text-clay shadow-[var(--shadow-soft)]"
              title="Album cover">
          <i class="fas fa-star" aria-hidden="true"></i>
          <span class="sr-only">Album cover</span>
        </span>
      <% else %>
        <%= button_to set_cover_album_path(album, photo_id: photo.id),
                      method: :patch,
                      class: "icon-btn h-9 w-9 shadow-[var(--shadow-soft)]",
                      title: "Use as album cover",
                      "aria-label": "Use as album cover",
                      form_class: "contents",
                      data: { turbo_confirm: "Use this photo as the album cover?" } do %>
          <i class="fas fa-star" aria-hidden="true"></i>
        <% end %>
      <% end %>

      <%= button_to remove_photo_album_path(album, photo_id: photo.id),
                    method: :delete,
                    class: "icon-btn icon-btn-danger h-9 w-9 shadow-[var(--shadow-soft)]",
                    title: "Remove from album",
                    "aria-label": "Remove from album",
                    form_class: "contents",
                    data: { turbo_confirm: "Remove this photo from the album? It stays in your library." } do %>
        <i class="fas fa-xmark" aria-hidden="true"></i>
      <% end %>
    </div>
  <% end %>
</div>
