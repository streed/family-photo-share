<%#
  The "add photos to this album" picker.

  A partial so add/remove can re-render it over turbo_stream: a photo that is
  removed from the album has to reappear here, and one that is added has to
  disappear. Previously the stream only blanked the grid tile, so the picker
  kept offering a photo that was already in the album (and vice versa).

  Locals: album, pickable_photos, addable_photo_count, editable
%>
<% if editable && addable_photo_count.to_i > 0 %>
  <div class="add-photos-section mt-5">
    <h4>Add Photos to Album</h4>
    <p class="text-muted">Click on any photo below to add it to this album.</p>

    <div class="add-photos-grid">
      <% pickable_photos.each do |photo| %>
        <div class="add-photo-tile" id="<%= dom_id(photo, :addable) %>"
             data-controller="pending-button"
             data-pending-button-pending-class="is-pending">
          <%# button_to, not link_to: an <a> only responds to PATCH via Turbo, so
              a middle-click or a page where Turbo hasn't booted issued a GET and
              silently 404'd instead of adding the photo. %>
          <%= button_to add_photo_album_path(album, photo_id: photo.id),
                        method: :patch,
                        class: "add-photo-link",
                        title: "Add #{photo_title_or_default(photo)} to this album",
                        form: {
                          class: "add-photo-form",
                          data: { action: "submit->pending-button#start" }
                        } do %>
            <div class="add-photo-container">
              <%= photo_thumbnail_tag photo, css_class: "add-photo-thumbnail" %>
              <div class="add-photo-overlay">
                <div class="add-photo-icon">
                  <i class="fas fa-plus" aria-hidden="true"></i>
                </div>
                <div class="add-photo-info">
                  <div class="add-photo-title"><%= truncated_photo_title(photo, length: 20) %></div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if addable_photo_count > 20 %>
      <div class="text-center mt-3">
        <small class="text-muted">
          Showing 20 of <%= addable_photo_count %> photos not yet in this album.
          <%= link_to "Browse all your photos", photos_path %> to add more.
        </small>
      </div>
    <% end %>
  </div>
<% elsif editable %>
  <%# The empty state used to tell people to "add photos from your library" while
      offering no way to do it, and no upload link anywhere on the page. %>
  <div class="add-photos-section mt-5 text-center">
    <% if album.photo_count.zero? %>
      <h4>No photos yet</h4>
      <p class="text-muted">
        <% if album.user.photos.exists? %>
          Every photo in your library is already in this album.
        <% else %>
          You haven't uploaded any photos yet.
        <% end %>
      </p>
    <% else %>
      <p class="text-muted mb-3">Every photo in your library is already in this album.</p>
    <% end %>
    <%= link_to "Upload Photos", new_photo_path, class: "btn btn-primary" %>
    <%= link_to "Bulk Upload", new_bulk_upload_path, class: "btn btn-outline-primary ms-2" %>
  </div>
<% end %>
