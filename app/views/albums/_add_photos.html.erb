<%#
  The "add photos to this album" picker.

  A partial so add/remove can re-render it over turbo_stream: a photo that is
  removed from the album has to reappear here, and one that is added has to
  disappear. Previously the stream only blanked the grid tile, so the picker
  kept offering a photo that was already in the album (and vice versa).

  Locals: album, pickable_photos, addable_photo_count, can_add

  `can_add` covers the owner and, on a collaborative family album, any family
  member the owner has invited to contribute. Everything offered here comes from
  the signed-in user's own library, whichever of the two they are.
%>
<% if can_add && addable_photo_count.to_i > 0 %>
  <section class="mt-10 rounded-[var(--radius-card)] border border-edge-soft bg-paper-deep p-5 sm:p-6">
    <h2 class="section-title">Add photos to this album</h2>
    <p class="meta mb-4">Tap a photo to add it. It stays in your library either way.</p>

    <div class="grid-photos">
      <% pickable_photos.each do |photo| %>
        <div id="<%= dom_id(photo, :addable) %>"
             data-controller="pending-button"
             data-pending-button-pending-class="is-pending">
          <%# button_to, not link_to: an <a> only responds to PATCH via Turbo, so
              a middle-click or a page where Turbo hasn't booted issued a GET and
              silently 404'd instead of adding the photo. %>
          <%= button_to add_photo_album_path(album, photo_id: photo.id),
                        method: :patch,
                        class: "tile group relative block w-full text-left",
                        title: "Add #{photo_title_or_default(photo)} to this album",
                        form: {
                          class: "contents",
                          data: { action: "submit->pending-button#start" }
                        } do %>
            <span class="relative block">
              <%= photo_thumbnail_tag photo %>
              <span class="absolute inset-0 flex items-center justify-center rounded-md bg-primary-deep/0 opacity-0 transition group-hover:bg-primary-deep/45 group-hover:opacity-100">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-primary-deep">
                  <i class="fas fa-plus" aria-hidden="true"></i>
                </span>
              </span>
            </span>
            <span class="block truncate px-1 pb-1 pt-2 text-sm font-semibold text-ink">
              <%= truncated_photo_title(photo, length: 22) %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if addable_photo_count > 20 %>
      <p class="meta mt-4 text-center">
        Showing 20 of <%= addable_photo_count %> photos not yet in this album.
        <%= link_to "Browse all your photos", photos_path, class: "link" %> to add more.
      </p>
    <% end %>
  </section>
<% elsif can_add %>
  <%# The empty state used to tell people to "add photos from your library" while
      offering no way to do it, and no upload link anywhere on the page. %>
  <section class="empty mt-10">
    <i class="fas fa-images empty-icon" aria-hidden="true"></i>
    <%# Whether *you* have anything left to add — the old check asked whether the
        album's owner had photos, which is the wrong person on a shared album. %>
    <% if !current_user.photos.exists? %>
      <h2 class="section-title">Nothing to add yet</h2>
      <p class="meta">You haven't uploaded any photos.</p>
    <% else %>
      <h2 class="section-title">Everything's already here</h2>
      <p class="meta">Every photo in your library is in this album.</p>
    <% end %>
    <div class="flex flex-wrap justify-center gap-2">
      <%= link_to "Upload photos", new_photo_path, class: "btn btn-primary" %>
      <%= link_to "Upload a batch", new_bulk_upload_path, class: "btn btn-secondary" %>
    </div>
  </section>
<% end %>
