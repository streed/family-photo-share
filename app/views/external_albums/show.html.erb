<% content_for :title, "#{@album.name} — shared album" %>

<div class="shell"
     data-controller="guest-session"
     data-guest-session-expires-at-value="<%= @current_guest_session&.expires_at&.to_i * 1000 || (Time.current + 10.minutes).to_i * 1000 %>">

  <%# Session warning. Hidden until the guest-session controller shows it —
      flash messages themselves are rendered once, by the layout. %>
  <div class="notice notice-warning mb-4" data-guest-session-target="warning" hidden>
    <i class="fas fa-triangle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
    <div>Your access expires soon. Keep browsing and it extends automatically.</div>
  </div>

  <header class="mounted-ink mb-8 rounded-[var(--radius-card)] border border-edge-soft bg-card p-6 sm:p-8">
    <h1 class="page-title"><%= @album.name %></h1>
    <% if @album.description.present? %>
      <p class="mt-2 max-w-2xl text-lg text-body"><%= @album.description %></p>
    <% end %>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="badge badge-private">
        <i class="fas fa-images" aria-hidden="true"></i>
        <%= pluralize(@album.photo_count, "photo") %>
      </span>
      <span class="badge badge-info">
        <i class="fas fa-user" aria-hidden="true"></i>
        Shared by <%= @album.user.display_name_or_full_name %>
      </span>
    </div>
  </header>

  <% if @photos.any? %>
    <div data-controller="slideshow"
         data-slideshow-track-url-value="<%= track_external_photo_view_path(@album.sharing_token) %>">
      <div class="grid-photos">
        <% @photos.each_with_index do |photo, index| %>
          <div class="tile cursor-zoom-in"
               role="button"
               tabindex="0"
               aria-label="View <%= photo_title_or_default(photo) %>"
               data-action="click->slideshow#open keydown.enter->slideshow#open keydown.space->slideshow#open"
               data-slideshow-index-value="<%= index %>"
               data-slideshow-photo-id-value="<%= photo.id %>">
            <%= image_tag photo.short_thumbnail_url,
                  alt: photo_title_or_default(photo),
                  loading: "lazy",
                  decoding: "async",
                  class: "photo-thumbnail",
                  data: {
                    large: photo.short_medium_url,
                    title: photo_title_or_default(photo),
                    description: photo.description,
                    user: photo.user.display_name_or_full_name,
                    taken_at: photo.taken_at&.strftime("%B %-d, %Y")
                  } %>
            <div class="px-1 pb-1 pt-2">
              <p class="truncate font-semibold text-ink"><%= truncated_photo_title(photo, length: 28) %></p>
              <% if photo.taken_at %>
                <p class="meta"><%= photo.taken_at.strftime("%B %-d, %Y") %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# --- Slideshow ---------------------------------------------------- %>
      <div class="modal" data-slideshow-target="modal"
           role="dialog" aria-modal="true" aria-hidden="true" aria-label="Photo viewer">
        <div class="modal-overlay" data-action="click->slideshow#close" aria-hidden="true"></div>

        <div class="relative z-10 flex h-full w-full flex-col items-center justify-center p-4">
          <button class="icon-btn absolute right-4 top-4 z-20" type="button"
                  aria-label="Close photo viewer" data-action="click->slideshow#close">
            <i class="fas fa-xmark" aria-hidden="true"></i>
          </button>

          <button class="icon-btn absolute left-2 top-1/2 z-20 h-12 w-12 -translate-y-1/2 sm:left-6" type="button"
                  aria-label="Previous photo" data-action="click->slideshow#previous">
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
          </button>

          <img class="max-h-[72vh] max-w-full rounded-lg object-contain shadow-[var(--shadow-lift)]"
               data-slideshow-target="image" src="" alt="">

          <div class="mt-4 max-w-xl text-center text-white">
            <h2 class="font-display text-xl font-semibold text-white" data-slideshow-target="title"></h2>
            <p class="mt-1 text-white/85" data-slideshow-target="description"></p>
            <p class="mt-1 text-sm text-white/70">
              Photo <span data-slideshow-target="counter"></span> of <%= @photos.size %>
              · by <span data-slideshow-target="user"></span><span data-slideshow-target="takenAt"></span>
            </p>
          </div>

          <button class="icon-btn absolute right-2 top-1/2 z-20 h-12 w-12 -translate-y-1/2 sm:right-6" type="button"
                  aria-label="Next photo" data-action="click->slideshow#next">
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>
  <% else %>
    <div class="empty">
      <i class="fas fa-images empty-icon" aria-hidden="true"></i>
      <h2 class="section-title">Nothing here yet</h2>
      <p class="meta">This album doesn't have any photos in it.</p>
    </div>
  <% end %>
</div>
