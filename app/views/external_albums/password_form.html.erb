<% content_for :title, "Password needed — shared album" %>

<div class="shell-narrow">
  <div class="card mt-6">
    <div class="card-body p-6 text-center sm:p-8">
      <span class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-soft text-2xl text-primary">
        <i class="fas fa-lock" aria-hidden="true"></i>
      </span>

      <h1 class="page-title text-2xl sm:text-3xl">This album is password protected</h1>
      <p class="page-subtitle">Enter the password the album's owner sent you.</p>

      <%= form_with url: external_album_authenticate_path(@album.sharing_token),
                    method: :post,
                    class: "mt-6 text-left",
                    data: { turbo: false } do |form| %>
        <div class="field">
          <%= form.label :password, "Password", class: "field-label" %>
          <%# A text field on purpose: the owner sends this password out in the
              open, and typing it blind on a phone is the main way people fail. %>
          <%= form.text_field :password,
                class: "field-input text-center text-lg",
                placeholder: "Album password",
                autocomplete: "off",
                autocapitalize: "none",
                autocorrect: "off",
                spellcheck: "false",
                autofocus: true,
                required: true %>
        </div>

        <%= form.submit "Open album", class: "btn btn-primary btn-lg btn-block" %>
      <% end %>
    </div>
  </div>

  <p class="meta mt-4 text-center">
    Don't have the password? Ask whoever shared the link with you.
  </p>
</div>
