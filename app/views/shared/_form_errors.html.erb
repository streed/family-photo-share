<%# Validation errors for a record, in one consistent block.
    Locals: record %>
<% if record.errors.any? %>
  <div class="notice notice-danger mb-5" role="alert">
    <i class="fas fa-circle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
    <div>
      <p class="font-semibold">Please fix <%= pluralize(record.errors.count, "thing") %> before saving:</p>
      <ul class="mt-1 list-disc space-y-0.5 pl-5">
        <% record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
