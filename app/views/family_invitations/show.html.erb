<% content_for :title, "Invitation to #{@invitation.family.name}" %>

<div class="shell-narrow">
  <div class="card mt-4">
    <div class="border-b border-edge-soft bg-paper-deep px-6 py-7 text-center">
      <span class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-card text-xl text-primary">
        <i class="fas fa-users" aria-hidden="true"></i>
      </span>
      <p class="meta">You've been invited to join</p>
      <h1 class="page-title text-2xl sm:text-3xl"><%= @invitation.family.name %></h1>
    </div>

    <div class="card-body p-6 sm:p-8">
      <% if @invitation.family.description.present? %>
        <p class="mb-5 text-center"><%= @invitation.family.description %></p>
      <% end %>

      <dl class="mb-6 grid grid-cols-3 gap-2 rounded-[12px] bg-paper-deep p-4 text-center">
        <div>
          <dt class="meta">Members</dt>
          <dd class="font-display text-xl font-semibold text-ink"><%= @invitation.family.member_count %></dd>
        </div>
        <div>
          <dt class="meta">Photos</dt>
          <dd class="font-display text-xl font-semibold text-ink"><%= @invitation.family.shared_photos.count %></dd>
        </div>
        <div>
          <dt class="meta">Together for</dt>
          <dd class="font-semibold text-ink"><%= time_ago_in_words(@invitation.family.created_at) %></dd>
        </div>
      </dl>

      <p class="meta mb-6 text-center">
        Invited by <strong class="text-ink"><%= @invitation.inviter.display_name_or_full_name %></strong>
        <%= time_ago_in_words(@invitation.created_at) %> ago ·
        expires in <%= time_ago_in_words(@invitation.expires_at) %>
      </p>

      <% if user_signed_in? %>
        <% if current_user.email == @invitation.email %>
          <% if current_user.has_family? %>
            <div class="notice notice-warning mb-4">
              <i class="fas fa-triangle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
              <div>You're already in a family. Leave that one first to join this one.</div>
            </div>
            <%= link_to "Back to home", root_path, class: "btn btn-secondary btn-block" %>
          <% else %>
            <div class="flex flex-col gap-2">
              <%= button_to "Accept and join", accept_invitation_path(@invitation.token), method: :patch,
                    class: "btn btn-primary btn-lg btn-block", form_class: "contents" %>
              <%= button_to "Decline", decline_invitation_path(@invitation.token), method: :patch,
                    class: "btn btn-ghost btn-block", form_class: "contents",
                    data: { turbo_confirm: "Decline this invitation?" } %>
            </div>
          <% end %>
        <% else %>
          <div class="notice notice-warning mb-4">
            <i class="fas fa-triangle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
            <div>
              This invitation was sent to <strong><%= @invitation.email %></strong>,
              but you're signed in as <strong><%= current_user.email %></strong>.
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <%= button_to "Sign out and use another account", destroy_user_session_path, method: :delete,
                  class: "btn btn-secondary btn-block", form_class: "contents" %>
            <%= link_to "Back to home", root_path, class: "btn btn-ghost btn-block" %>
          </div>
        <% end %>
      <% else %>
        <div class="notice notice-info mb-4">
          <i class="fas fa-circle-info mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>Sign in as <strong><%= @invitation.email %></strong> to accept.</div>
        </div>
        <div class="flex flex-col gap-2">
          <%= link_to "Sign in to accept", new_user_session_path, class: "btn btn-primary btn-lg btn-block" %>
          <%# Carry the token: this is the invitation-aware route, which works even
              when open sign-up is switched off, and joins them to the family. %>
          <%= link_to "Create an account", invitation_signup_path(@invitation.token),
                class: "btn btn-secondary btn-block" %>
          <%= button_to "Decline", decline_invitation_path(@invitation.token), method: :patch,
                class: "btn btn-ghost btn-block", form_class: "contents",
                data: { turbo_confirm: "Decline this invitation?" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
