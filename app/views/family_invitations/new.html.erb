<% content_for :title, "Invite someone — Family Memories" %>

<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title">Invite someone</h1>
      <p class="page-subtitle">To <%= @family.name %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Back to family", family_path(@family), class: "btn btn-ghost btn-sm" %>
      <%= link_to "Members", members_family_path(@family), class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="card">
      <div class="card-head"><h2 class="section-title">Send an invitation</h2></div>
      <div class="card-body">
        <%= form_with model: @invitation, url: family_invitations_path(@family) do |form| %>
          <%= render "shared/form_errors", record: @invitation %>

          <div class="field">
            <%= form.label :email, "Their email address", class: "field-label" %>
            <%= form.email_field :email, class: "field-input", placeholder: "gran@example.com", required: true %>
            <p class="field-hint">They'll get an email with a link to join.</p>
          </div>

          <div class="flex flex-wrap gap-2">
            <%= form.submit "Send invitation", class: "btn btn-primary" %>
            <%= link_to "Cancel", family_path(@family), class: "btn btn-ghost" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <h2 class="section-title">Waiting to be accepted (<%= @pending_invitations.count %>)</h2>
      </div>

      <% if @pending_invitations.any? %>
        <div class="rows">
          <% @pending_invitations.each do |invitation| %>
            <div class="row-item">
              <div class="min-w-0">
                <p class="truncate font-semibold text-ink"><%= invitation.email %></p>
                <p class="meta">Sent <%= time_ago_in_words(invitation.created_at) %> ago</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="badge <%= invitation.expires_at < Time.current ? "badge-danger" : "badge-link" %>">
                  <%= invitation.expires_at < Time.current ? "Expired" : "Pending" %>
                </span>
                <%= button_to family_invitation_path(@family, invitation), method: :delete,
                      class: "icon-btn icon-btn-danger h-9 w-9",
                      form_class: "contents",
                      aria: { label: "Cancel invitation to #{invitation.email}" },
                      data: { turbo_confirm: "Cancel the invitation to #{invitation.email}?" } do %>
                  <i class="fas fa-xmark" aria-hidden="true"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="card-body">
          <p class="meta">No invitations are waiting.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
