<% content_for :title, "#{photo_title_or_default(@photo)} — Family Memories" %>

<div class="shell">
  <div class="mb-4">
    <%= link_to photos_path, class: "link no-underline" do %>
      <i class="fas fa-chevron-left" aria-hidden="true"></i> All photos
    <% end %>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div>
      <% if @photo.image.attached? %>
        <figure class="relative overflow-hidden rounded-[var(--radius-card)] border border-edge-soft bg-primary-deep">
          <%= image_tag robust_photo_url(@photo, :xl),
                alt: photo_title_or_default(@photo),
                class: "mx-auto max-h-[70vh] w-auto object-contain",
                onerror: "this.src='#{@photo.short_original_url}'; this.onerror=null;" %>

          <% if @photo.processing_failed? %>
            <figcaption class="absolute inset-x-0 bottom-0 flex flex-wrap items-center gap-3 bg-black/70 p-3 text-sm text-white backdrop-blur">
              <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
              <span class="grow">
                Optimized versions couldn't be generated. You're seeing the original, which is fine to view and download.
              </span>
              <% if current_user == @photo.user && @photo.retryable? %>
                <%= button_to "Retry", retry_processing_photo_path(@photo), method: :patch,
                      class: "btn btn-sm btn-on-photo" %>
              <% end %>
            </figcaption>
          <% elsif !@photo.processing_settled? %>
            <figcaption class="absolute right-3 top-3 rounded-full bg-black/65 px-3 py-1.5 text-sm text-white backdrop-blur"
                        data-controller="processing-status"
                        data-processing-status-url-value="<%= processing_status_photo_path(@photo) %>">
              <i class="fas fa-gear fa-spin mr-1" aria-hidden="true"></i>
              <span data-processing-status-target="message">Preparing optimized versions…</span>
            </figcaption>
          <% end %>
        </figure>
      <% end %>

      <div class="card mt-4">
        <div class="card-body">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <h1 class="page-title text-2xl sm:text-3xl"><%= photo_title_or_default(@photo) %></h1>
            <% if current_user == @photo.user %>
              <div class="flex gap-2">
                <%= link_to "Edit", edit_photo_path(@photo), class: "btn btn-secondary btn-sm" %>
                <%= button_to "Delete", photo_path(@photo), method: :delete,
                      class: "btn btn-danger-quiet btn-sm",
                      form_class: "contents",
                      data: { turbo_confirm: "Delete this photo? It will be removed from every album." } %>
              </div>
            <% end %>
          </div>

          <% if @photo.description.present? %>
            <div class="mt-3 text-body"><%= simple_format(@photo.description) %></div>
          <% end %>

          <dl class="mt-5 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-semibold text-ink">Uploaded by</dt>
              <dd><%= link_to @photo.user.display_name_or_full_name, profile_path(@photo.user), class: "link" %></dd>
            </div>
            <div>
              <dt class="font-semibold text-ink">Uploaded</dt>
              <dd class="text-muted"><%= @photo.created_at.strftime("%B %-d, %Y at %-I:%M %p") %></dd>
            </div>
            <% if @photo.taken_at.present? %>
              <div>
                <dt class="font-semibold text-ink">Taken</dt>
                <dd class="text-muted"><%= @photo.taken_at.strftime("%B %-d, %Y") %></dd>
              </div>
            <% end %>
            <% if @photo.location.present? %>
              <div>
                <dt class="font-semibold text-ink">Location</dt>
                <dd class="text-muted"><%= @photo.location %></dd>
              </div>
            <% end %>
            <% if @photo.formatted_file_size.present? %>
              <div>
                <dt class="font-semibold text-ink">File size</dt>
                <dd class="text-muted"><%= @photo.formatted_file_size %></dd>
              </div>
            <% end %>
            <% if @photo.image_dimensions.present? %>
              <div>
                <dt class="font-semibold text-ink">Dimensions</dt>
                <dd class="text-muted"><%= @photo.image_dimensions %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </div>

    <aside class="space-y-4">
      <div class="card">
        <div class="card-head"><h2 class="section-title">This photo</h2></div>
        <div class="card-body flex flex-col gap-2">
          <%= link_to "Open full size", robust_photo_url(@photo, :original), class: "btn btn-secondary btn-block", target: "_blank", rel: "noopener" %>
          <%= link_to "Download", robust_photo_url(@photo, :original), class: "btn btn-secondary btn-block", download: @photo.image.filename.to_s %>
          <%= link_to "Back to photos", photos_path, class: "btn btn-ghost btn-block" %>
        </div>
      </div>

      <% if @photo.albums.any? %>
        <div class="card">
          <div class="card-head"><h2 class="section-title">In albums</h2></div>
          <div class="rows">
            <% @photo.albums.each do |album| %>
              <div class="row-item">
                <%= link_to album.name, album_path(album), class: "link no-underline font-semibold" %>
                <span class="meta"><%= pluralize(album.photo_count, "photo") %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </aside>
  </div>
</div>
