<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title">My Photos</h1>
      <% if @photos.any? %>
        <p class="page-subtitle">
          Showing <%= @photos.size %> of <%= @total_count %>
          <%= "photo".pluralize(@total_count) %><%= " · page #{@page} of #{@total_pages}" if @total_pages > 1 %>
        </p>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to new_photo_path, class: "btn btn-primary" do %>
        <i class="fas fa-arrow-up-from-bracket" aria-hidden="true"></i> Upload a photo
      <% end %>
      <%= link_to "Upload a batch", new_bulk_upload_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <% if @photos.any? %>
    <div class="grid-photos">
      <% @photos.each do |photo| %>
        <div class="group relative">
          <%= link_to photo_path(photo), class: "tile block" do %>
            <% if photo.image.attached? %>
              <%= image_tag photo.short_small_url,
                    alt: photo_title_or_default(photo),
                    loading: "lazy",
                    class: "tile-img tile-img-square" %>
            <% else %>
              <div class="tile-img tile-img-square flex items-center justify-center text-muted">
                <i class="fas fa-image text-2xl" aria-hidden="true"></i>
              </div>
            <% end %>

            <div class="px-1 pb-1 pt-2">
              <p class="truncate font-semibold text-ink"><%= truncated_photo_title(photo, length: 28) %></p>
              <p class="meta">
                <% if photo.taken_at.present? %>
                  <%= photo.taken_at.strftime("%b %-d, %Y") %>
                <% else %>
                  Added <%= time_ago_in_words(photo.created_at) %> ago
                <% end %>
              </p>
            </div>
          <% end %>

          <% if current_user == photo.user %>
            <div class="absolute right-2 top-2 flex gap-1 opacity-0 transition-opacity focus-within:opacity-100 group-hover:opacity-100 max-md:opacity-100">
              <%= link_to edit_photo_path(photo),
                    class: "icon-btn h-9 w-9 shadow-[var(--shadow-soft)]",
                    aria: { label: "Edit #{photo_title_or_default(photo)}" } do %>
                <i class="fas fa-pen" aria-hidden="true"></i>
              <% end %>
              <%= button_to photo_path(photo), method: :delete,
                    class: "icon-btn icon-btn-danger h-9 w-9 shadow-[var(--shadow-soft)]",
                    form_class: "contents",
                    aria: { label: "Delete #{photo_title_or_default(photo)}" },
                    data: { turbo_confirm: "Delete this photo? It will be removed from every album." } do %>
                <i class="fas fa-trash-can" aria-hidden="true"></i>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= render "shared/pager",
               page: @page,
               total_pages: @total_pages,
               path_for_page: ->(n) { photos_path(request.query_parameters.merge(page: n)) } %>
  <% else %>
    <div class="empty">
      <i class="fas fa-images empty-icon" aria-hidden="true"></i>
      <% if @total_count.to_i > 0 %>
        <h2 class="section-title">Nothing on this page</h2>
        <p class="meta">There are <%= pluralize(@total_count, "photo") %>, but none on page <%= @page %>.</p>
        <%= link_to "Back to the first page", photos_path(request.query_parameters.except("page")), class: "btn btn-primary" %>
      <% else %>
        <h2 class="section-title">No photos yet</h2>
        <p class="meta max-w-sm">Upload the first one — you can sort them into albums afterwards.</p>
        <%= link_to "Upload a photo", new_photo_path, class: "btn btn-primary btn-lg" %>
      <% end %>
    </div>
  <% end %>
</div>
