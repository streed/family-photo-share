<% content_for :title, "Upload a photo — Family Memories" %>

<div class="shell">
  <div class="mx-auto max-w-2xl">
    <h1 class="page-title mb-6">Upload a photo</h1>

    <div class="card">
      <div class="card-body">
        <%= form_with model: @photo, multipart: true,
              data: { controller: "form", action: "submit->form#submit" } do |form| %>
          <%= render "shared/form_errors", record: @photo %>

          <div class="field" data-controller="file-upload">
            <%= form.label :image, "Photo", class: "field-label" %>
            <%= form.file_field :image, class: "field-input py-2", accept: "image/*", required: true,
                  data: { "file-upload-target": "input", action: "change->file-upload#change" } %>
            <p class="field-hint">PNG, JPEG or GIF, up to 50MB.</p>
            <div data-file-upload-target="preview" class="mt-3"></div>
          </div>

          <div class="field">
            <%= form.label :title, class: "field-label" %>
            <%= form.text_field :title, class: "field-input", placeholder: "Optional — untitled is fine" %>
          </div>

          <div class="field">
            <%= form.label :description, class: "field-label" %>
            <%= form.text_area :description, class: "field-input", rows: 3, placeholder: "What's happening in this photo?" %>
          </div>

          <div class="grid gap-x-5 sm:grid-cols-2">
            <div class="field">
              <%= form.label :location, class: "field-label" %>
              <%= form.text_field :location, class: "field-input", placeholder: "Where was it taken?" %>
            </div>
            <div class="field">
              <%= form.label :taken_at, "Date taken", class: "field-label" %>
              <%= form.date_field :taken_at, class: "field-input" %>
            </div>
          </div>

          <div class="mt-2 flex flex-wrap gap-2">
            <%= form.submit "Upload photo", class: "btn btn-primary", data: { "form-target": "submit" } %>
            <%= link_to "Cancel", photos_path, class: "btn btn-ghost" %>
          </div>
        <% end %>
      </div>
    </div>

    <p class="meta mt-4 text-center">
      Adding a lot at once? <%= link_to "Use the batch uploader", new_bulk_upload_path, class: "link" %>.
    </p>
  </div>
</div>
