<% content_for :title, "#{@family.name} — Family Memories" %>
<% is_admin = @family.admin?(current_user) %>

<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title"><%= @family.name %></h1>
      <% if @family.description.present? %>
        <p class="page-subtitle max-w-2xl"><%= @family.description %></p>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-2">
      <% if is_admin %>
        <%= link_to new_family_invitation_path(@family), class: "btn btn-primary btn-sm" do %>
          <i class="fas fa-user-plus" aria-hidden="true"></i> Invite someone
        <% end %>
        <%= link_to "Members", members_family_path(@family), class: "btn btn-secondary btn-sm" %>
        <%= link_to "Edit", edit_family_path(@family), class: "btn btn-secondary btn-sm" %>
      <% else %>
        <%= button_to "Leave family", leave_family_path(@family), method: :patch,
              class: "btn btn-danger-quiet btn-sm",
              form_class: "contents",
              data: { turbo_confirm: "Leave #{@family.name}? You'll lose access to albums shared with it." } %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <section class="card">
      <div class="card-head">
        <h2 class="section-title">Recent family photos</h2>
        <%= link_to "See all", photos_path(family_id: @family.id), class: "link" %>
      </div>

      <div class="card-body">
        <% if @recent_photos.any? %>
          <div class="grid-photos">
            <% @recent_photos.each do |photo| %>
              <%= link_to photo_path(photo), class: "tile" do %>
                <%= image_tag photo.short_thumbnail_url,
                      alt: photo_title_or_default(photo),
                      loading: "lazy",
                      class: "photo-thumbnail" %>
                <div class="px-1 pb-1 pt-2">
                  <p class="truncate font-semibold text-ink"><%= truncated_photo_title(photo, length: 22) %></p>
                  <p class="meta truncate">
                    by <%= photo.user.display_name_or_full_name %> ·
                    <%= photo.taken_at.present? ? photo.taken_at.strftime("%b %-d") : "#{time_ago_in_words(photo.created_at)} ago" %>
                  </p>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="empty border-0 bg-transparent">
            <i class="fas fa-images empty-icon" aria-hidden="true"></i>
            <p class="meta">Nobody has shared a photo yet.</p>
            <%= link_to "Upload the first one", new_photo_path, class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </section>

    <aside class="space-y-6">
      <section class="card">
        <div class="card-head"><h2 class="section-title">Members</h2></div>

        <div class="rows">
          <% @members.each do |membership| %>
            <div class="row-item">
              <div class="flex min-w-0 items-center gap-3">
                <%= render "shared/avatar", user: membership.user, size: :sm %>
                <div class="min-w-0">
                  <p class="truncate font-semibold text-ink"><%= membership.user.display_name_or_full_name %></p>
                  <p class="meta">
                    <%= membership.role.capitalize %><%= " · joined #{time_ago_in_words(membership.joined_at)} ago" if membership.joined_at %>
                  </p>
                </div>
              </div>
              <% if membership.admin? %>
                <span class="badge badge-link">Admin</span>
              <% end %>
            </div>
          <% end %>

          <% if is_admin && @pending_invitations.any? %>
            <div class="row-item bg-paper-deep">
              <p class="section-title text-base">Invited, not joined yet</p>
            </div>
            <% @pending_invitations.each do |invitation| %>
              <div class="row-item">
                <span class="min-w-0 truncate">
                  <i class="fas fa-envelope mr-1 text-muted" aria-hidden="true"></i>
                  <%= invitation.email %>
                </span>
                <span class="meta"><%= time_ago_in_words(invitation.created_at) %> ago</span>
              </div>
            <% end %>
          <% end %>
        </div>

        <% if is_admin %>
          <div class="border-t border-edge-soft p-4">
            <%= link_to "Manage members", members_family_path(@family), class: "btn btn-secondary btn-block btn-sm" %>
          </div>
        <% end %>
      </section>

      <section class="card">
        <div class="card-head"><h2 class="section-title">At a glance</h2></div>
        <div class="rows">
          <div class="row-item">
            <span class="meta">Members</span>
            <strong class="text-ink"><%= @family.member_count %></strong>
          </div>
          <div class="row-item">
            <span class="meta">Photos shared</span>
            <strong class="text-ink"><%= @family.shared_photos.count %></strong>
          </div>
          <div class="row-item">
            <span class="meta">Created</span>
            <strong class="text-ink"><%= time_ago_in_words(@family.created_at) %> ago</strong>
          </div>
          <div class="row-item">
            <span class="meta">Created by</span>
            <strong class="text-ink"><%= @family.created_by.display_name_or_full_name %></strong>
          </div>
        </div>
      </section>
    </aside>
  </div>
</div>
