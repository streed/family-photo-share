<% content_for :title, "Members of #{@family.name} — Family Memories" %>
<% is_admin = @family.admin?(current_user) %>

<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title">Members</h1>
      <p class="page-subtitle"><%= @family.name %></p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "Back to family", family_path(@family), class: "btn btn-ghost btn-sm" %>
      <% if is_admin %>
        <%= link_to "Edit family", edit_family_path(@family), class: "btn btn-secondary btn-sm" %>
        <%= link_to new_family_invitation_path(@family), class: "btn btn-primary btn-sm" do %>
          <i class="fas fa-user-plus" aria-hidden="true"></i> Invite someone
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <section class="card">
      <div class="card-head">
        <h2 class="section-title">In this family (<%= @members.count %>)</h2>
      </div>

      <% if @members.any? %>
        <div class="rows">
          <% @members.each do |membership| %>
            <div class="row-item">
              <div class="flex min-w-0 items-center gap-3">
                <%= render "shared/avatar", user: membership.user, size: :md %>
                <div class="min-w-0">
                  <p class="truncate font-semibold text-ink">
                    <%= membership.user.display_name_or_full_name %>
                    <% if membership.user == current_user %><span class="meta">(you)</span><% end %>
                  </p>
                  <p class="meta truncate"><%= membership.user.email %></p>
                  <% if membership.joined_at %>
                    <p class="meta">Joined <%= time_ago_in_words(membership.joined_at) %> ago</p>
                  <% end %>
                </div>
              </div>
              <span class="badge <%= membership.admin? ? "badge-link" : "badge-private" %>">
                <%= membership.admin? ? "Admin" : "Member" %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="card-body">
          <p class="meta">No members yet.</p>
        </div>
      <% end %>
    </section>

    <aside class="space-y-6">
      <section class="card">
        <div class="card-head"><h2 class="section-title">Invited</h2></div>

        <% if @pending_invitations.any? %>
          <div class="rows">
            <% @pending_invitations.each do |invitation| %>
              <div class="row-item">
                <div class="min-w-0">
                  <p class="truncate font-semibold text-ink"><%= invitation.email %></p>
                  <p class="meta">
                    <%= time_ago_in_words(invitation.created_at) %> ago
                    by <%= invitation.inviter.display_name_or_full_name %>
                  </p>
                </div>
                <% if is_admin %>
                  <%= button_to family_invitation_path(@family, invitation), method: :delete,
                        class: "icon-btn icon-btn-danger h-9 w-9",
                        form_class: "contents",
                        aria: { label: "Cancel invitation to #{invitation.email}" },
                        data: { turbo_confirm: "Cancel the invitation to #{invitation.email}?" } do %>
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card-body">
            <p class="meta">Nobody is waiting on an invitation.</p>
          </div>
        <% end %>

        <% if is_admin %>
          <div class="border-t border-edge-soft p-4">
            <%= link_to "Send an invitation", new_family_invitation_path(@family), class: "btn btn-primary btn-block btn-sm" %>
          </div>
        <% end %>
      </section>

      <section class="card">
        <div class="card-head"><h2 class="section-title">At a glance</h2></div>
        <div class="rows">
          <div class="row-item">
            <span class="meta">Members</span>
            <strong class="text-ink"><%= @family.member_count %></strong>
          </div>
          <div class="row-item">
            <span class="meta">Admins</span>
            <strong class="text-ink"><%= @family.family_memberships.admins.count %></strong>
          </div>
          <div class="row-item">
            <span class="meta">Invitations out</span>
            <strong class="text-ink"><%= @pending_invitations.count %></strong>
          </div>
          <div class="row-item">
            <span class="meta">Photos shared</span>
            <strong class="text-ink"><%= @family.shared_photos.count %></strong>
          </div>
        </div>
      </section>
    </aside>
  </div>
</div>
