<% content_for :title, "My family — Family Memories" %>

<div class="shell">
  <div class="page-head">
    <div>
      <h1 class="page-title">My Family</h1>
      <p class="page-subtitle">A family is the group you share albums with.</p>
    </div>
    <% if current_user.can_create_family? %>
      <%= link_to "Create a family", new_family_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <% if current_user.has_family? %>
    <div class="empty">
      <i class="fas fa-users empty-icon" aria-hidden="true"></i>
      <h2 class="section-title">You're in <%= current_user.family.name %></h2>
      <%= link_to "Go to your family", family_path(current_user.family), class: "btn btn-primary" %>
    </div>
  <% else %>
    <% if @pending_invitations.any? %>
      <section class="mb-10">
        <h2 class="section-title mb-3">Invitations waiting for you</h2>
        <div class="grid gap-4 lg:grid-cols-2">
          <% @pending_invitations.each do |invitation| %>
            <div class="card">
              <div class="card-head">
                <h3 class="section-title"><%= invitation.family.name %></h3>
                <span class="badge badge-link">Invitation</span>
              </div>
              <div class="card-body">
                <% if invitation.family.description.present? %>
                  <p class="mb-3"><%= truncate(invitation.family.description, length: 140) %></p>
                <% end %>

                <p class="meta mb-4">
                  From <%= invitation.inviter.display_name_or_full_name %>,
                  <%= time_ago_in_words(invitation.created_at) %> ago ·
                  expires in <%= time_ago_in_words(invitation.expires_at) %>
                </p>

                <div class="flex flex-wrap gap-2">
                  <%= button_to "Accept", accept_invitation_path(invitation.token), method: :patch,
                        class: "btn btn-primary btn-sm", form_class: "contents" %>
                  <%= button_to "Decline", decline_invitation_path(invitation.token), method: :patch,
                        class: "btn btn-ghost btn-sm", form_class: "contents",
                        data: { turbo_confirm: "Decline the invitation to #{invitation.family.name}?" } %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <div class="empty">
      <i class="fas fa-users empty-icon" aria-hidden="true"></i>
      <h2 class="section-title">You're not in a family yet</h2>
      <p class="meta max-w-md">
        Create one and invite the people you want to share albums with — or wait for someone to invite you.
      </p>
      <%= link_to "Create your family", new_family_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>
