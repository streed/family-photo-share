<% content_for :title, "Edit #{@family.name} — Family Memories" %>

<div class="shell">
  <div class="mx-auto max-w-2xl">
    <div class="page-head">
      <h1 class="page-title">Edit family</h1>
      <span class="badge badge-link">Admins only</span>
    </div>

    <div class="card">
      <div class="card-body">
        <%= form_with model: @family do |form| %>
          <%= render "shared/form_errors", record: @family %>

          <div class="field">
            <%= form.label :name, "Family name", class: "field-label" %>
            <%= form.text_field :name, class: "field-input", placeholder: "The Lovelaces" %>
            <p class="field-hint">Everyone in the family sees this name.</p>
          </div>

          <div class="field">
            <%= form.label :description, class: "field-label" %>
            <%= form.text_area :description, class: "field-input", rows: 4, placeholder: "Optional — what this group is for" %>
          </div>

          <dl class="mb-6 grid gap-x-6 gap-y-3 rounded-[12px] bg-paper-deep p-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="meta">Created</dt>
              <dd class="font-semibold text-ink"><%= @family.created_at.strftime("%B %-d, %Y") %></dd>
            </div>
            <div>
              <dt class="meta">Created by</dt>
              <dd class="font-semibold text-ink"><%= @family.created_by.display_name_or_full_name %></dd>
            </div>
            <div>
              <dt class="meta">Members</dt>
              <dd class="font-semibold text-ink"><%= @family.family_memberships.count %></dd>
            </div>
            <div>
              <dt class="meta">Photos shared</dt>
              <dd class="font-semibold text-ink"><%= @family.shared_photos.count %></dd>
            </div>
          </dl>

          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap gap-2">
              <%= form.submit "Save changes", class: "btn btn-primary" %>
              <%= link_to "Cancel", @family, class: "btn btn-ghost" %>
            </div>

            <% if @family.created_by == current_user && @family.family_memberships.count == 1 %>
              <%= button_to "Delete family", @family, method: :delete,
                    class: "btn btn-danger-quiet",
                    form_class: "contents",
                    data: { turbo_confirm: "Delete #{@family.name}? This can't be undone." } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
