<% content_for :title, "Create a family — Family Memories" %>

<div class="shell">
  <div class="mx-auto max-w-2xl">
    <h1 class="page-title mb-6">Create a family</h1>

    <div class="card">
      <div class="card-body">
        <%= form_with model: @family do |form| %>
          <%= render "shared/form_errors", record: @family %>

          <div class="field">
            <%= form.label :name, "Family name", class: "field-label" %>
            <%= form.text_field :name, class: "field-input", placeholder: "The Lovelaces" %>
          </div>

          <div class="field">
            <%= form.label :description, class: "field-label" %>
            <%= form.text_area :description, class: "field-input", rows: 4, placeholder: "Optional — what this group is for" %>
          </div>

          <div class="notice notice-info mb-6">
            <i class="fas fa-circle-info mt-0.5 shrink-0" aria-hidden="true"></i>
            <div>
              <p class="font-semibold">What happens next</p>
              <ul class="mt-1 list-disc space-y-0.5 pl-5">
                <li>You become the family's admin</li>
                <li>You can invite people by email</li>
                <li>Albums you mark "Family" become visible to everyone in it</li>
              </ul>
            </div>
          </div>

          <div class="flex flex-wrap gap-2">
            <%= form.submit "Create family", class: "btn btn-primary" %>
            <%= link_to "Cancel", families_path, class: "btn btn-ghost" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
