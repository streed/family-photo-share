<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "Shared album — Family Memories" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#faf7f2">
    <meta name="robots" content="noindex, nofollow">

    <%= render "shared/link_preview",
               title: "A shared photo album",
               description: "Someone has shared a private album with you. Open the link to view it." %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png?v=2">

    <%= render "shared/assets" %>
  </head>

  <body>
    <header class="border-b border-edge-soft bg-paper">
      <div class="shell flex h-16 items-center justify-between gap-4">
        <span class="font-display text-xl font-semibold text-ink sm:text-2xl">Family Memories</span>
        <span class="badge badge-private">
          <i class="fas fa-shield-halved" aria-hidden="true"></i>
          Guest view
        </span>
      </div>
    </header>

    <%= render "shared/flash" %>

    <main id="main" class="grow py-6 sm:py-10">
      <%= yield %>
    </main>

    <footer class="mt-auto border-t border-edge-soft py-6">
      <p class="shell text-center text-sm text-muted">
        Shared privately with you. Please don't pass the link on.
      </p>
    </footer>
  </body>
</html>
