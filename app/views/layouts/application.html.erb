<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "Family Memories — Share Your Special Moments" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#faf7f2">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "shared/assets" %>
  </head>

  <body>
    <a href="#main" class="sr-only-focusable btn btn-secondary absolute left-4 top-4 z-50">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-edge-soft bg-paper/95 backdrop-blur"
            data-controller="nav">
      <div class="shell flex h-16 items-center justify-between gap-4">
        <%= link_to root_path, class: "font-display text-xl font-semibold text-ink no-underline sm:text-2xl" do %>
          Family Memories
        <% end %>

        <% if user_signed_in? %>
          <%# Desktop navigation %>
          <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
            <%= nav_link_to "My Photos", photos_path %>
            <%= nav_link_to "Albums", albums_path %>
            <% if current_user.has_family? %>
              <%= nav_link_to "My Family", family_path(current_user.family) %>
            <% else %>
              <%= nav_link_to "Join Family", families_path %>
            <% end %>

            <%= link_to new_photo_path, class: "btn btn-primary btn-sm ml-2" do %>
              <i class="fas fa-arrow-up-from-bracket" aria-hidden="true"></i> Upload
            <% end %>

            <div class="relative ml-1" data-controller="dropdown">
              <button type="button"
                      class="flex h-11 w-11 items-center justify-center rounded-full border border-edge bg-card"
                      data-dropdown-trigger
                      data-action="click->dropdown#toggle"
                      aria-haspopup="true"
                      aria-expanded="false"
                      aria-label="Account menu">
                <%= render "shared/avatar", user: current_user, size: :sm %>
              </button>
              <div class="absolute right-0 top-full mt-2 w-52 overflow-hidden rounded-xl border border-edge-soft bg-card py-1 shadow-[var(--shadow-lift)]"
                   data-dropdown-target="menu"
                   hidden>
                <p class="truncate px-4 pb-2 pt-1 text-sm text-muted"><%= current_user.email %></p>
                <%= link_to "My profile", profile_path(current_user), class: "block px-4 py-2.5 text-body no-underline hover:bg-paper-deep hover:text-ink" %>
                <%= link_to "Settings", settings_path, class: "block px-4 py-2.5 text-body no-underline hover:bg-paper-deep hover:text-ink" %>
                <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                      class: "block w-full px-4 py-2.5 text-left text-body hover:bg-paper-deep hover:text-ink",
                      form_class: "border-t border-edge-soft" %>
              </div>
            </div>
          </nav>

          <%# Small-screen toggle %>
          <button type="button"
                  class="icon-btn md:hidden"
                  data-nav-target="toggle"
                  data-action="click->nav#toggle"
                  aria-controls="mobile-nav"
                  aria-expanded="false"
                  aria-label="Menu">
            <i class="fas fa-bars" aria-hidden="true"></i>
          </button>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>

      <% if user_signed_in? %>
        <nav id="mobile-nav"
             class="border-t border-edge-soft bg-card md:hidden"
             data-nav-target="panel"
             aria-label="Main"
             hidden>
          <div class="shell flex flex-col py-3">
            <%= link_to "My Photos", photos_path, class: "block border-b border-edge-soft py-3 font-semibold text-body no-underline" %>
            <%= link_to "Albums", albums_path, class: "block border-b border-edge-soft py-3 font-semibold text-body no-underline" %>
            <% if current_user.has_family? %>
              <%= link_to "My Family", family_path(current_user.family), class: "block border-b border-edge-soft py-3 font-semibold text-body no-underline" %>
            <% else %>
              <%= link_to "Join Family", families_path, class: "block border-b border-edge-soft py-3 font-semibold text-body no-underline" %>
            <% end %>
            <%= link_to "My profile", profile_path(current_user), class: "block border-b border-edge-soft py-3 font-semibold text-body no-underline" %>
            <%= link_to "Settings", settings_path, class: "block border-b border-edge-soft py-3 font-semibold text-body no-underline" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                  class: "block w-full py-3 text-left font-semibold text-body" %>
            <%= link_to new_photo_path, class: "btn btn-primary mt-3" do %>
              <i class="fas fa-arrow-up-from-bracket" aria-hidden="true"></i> Upload photos
            <% end %>
          </div>
        </nav>
      <% end %>
    </header>

    <%= render "shared/flash" %>

    <main id="main" class="grow py-6 sm:py-10">
      <%= yield %>
    </main>

    <footer class="mt-auto border-t border-edge-soft py-6">
      <p class="shell text-center text-sm text-muted">
        Made for families everywhere &middot; &copy; <%= Date.current.year %> Family Memories
      </p>
    </footer>
  </body>
</html>
